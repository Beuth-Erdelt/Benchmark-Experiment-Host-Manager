<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>POSTGRES</type>
    <driver>org.postgresql.Driver</driver>
    <url>jdbc:postgresql://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE?sslmode=disable&amp;ApplicationName=smallbank&amp;reWriteBatchedInserts=true</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>
    <isolation>BENCHBASE_ISOLATION</isolation>
    <batchsize>BENCHBASE_BATCHSIZE</batchsize>
    <newConnectionPerTxn>BENCHBASE_NEWCONNPERTXN</newConnectionPerTxn>

    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>15,15,15,25,15,15</weights>
        </work>
    </works>

    <!-- SmallBank Procedures declaration -->
    <transactiontypes>
        <transactiontype>
            <name>Amalgamate</name>
        </transactiontype>
        <transactiontype>
            <name>Balance</name>
        </transactiontype>
        <transactiontype>
            <name>DepositChecking</name>
        </transactiontype>
        <transactiontype>
            <name>SendPayment</name>
        </transactiontype>
        <transactiontype>
            <name>TransactSavings</name>
        </transactiontype>
        <transactiontype>
            <name>WriteCheck</name>
        </transactiontype>
    </transactiontypes>
</parameters>
