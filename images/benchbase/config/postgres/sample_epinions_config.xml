<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>POSTGRES</type>
    <driver>org.postgresql.Driver</driver>
    <url>jdbc:postgresql://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE?sslmode=disable&amp;ApplicationName=epinions&amp;reWriteBatchedInserts=true</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>
    <isolation>BENCHBASE_ISOLATION</isolation>
    <batchsize>BENCHBASE_BATCHSIZE</batchsize>
    <newConnectionPerTxn>BENCHBASE_NEWCONNPERTXN</newConnectionPerTxn>

    <!-- Scalefactor in Epinions scales by *2000 the number of users-->
    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>10,10,10,10,10,10,10,10,20</weights>
        </work>
    </works>

    <!-- Epinions Procedures Declaration -->
    <transactiontypes>
        <transactiontype>
            <name>GetReviewItemById</name>
        </transactiontype>
        <transactiontype>
            <name>GetReviewsByUser</name>
        </transactiontype>
        <transactiontype>
            <name>GetAverageRatingByTrustedUser</name>
        </transactiontype>
        <transactiontype>
            <name>GetItemAverageRating</name>
        </transactiontype>
        <transactiontype>
            <name>GetItemReviewsByTrustedUser</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateUserName</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateItemTitle</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateReviewRating</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateTrustRating</name>
        </transactiontype>
    </transactiontypes>
</parameters>
