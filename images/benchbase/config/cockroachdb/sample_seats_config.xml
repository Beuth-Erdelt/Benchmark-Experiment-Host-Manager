<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>COCKROACHDB</type>
    <driver>org.postgresql.Driver</driver>
    <url>jdbc:postgresql://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE?sslmode=disable&amp;ApplicationName=seats&amp;reWriteBatchedInserts=true</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>
    <isolation>BENCHBASE_ISOLATION</isolation>
    <batchsize>BENCHBASE_BATCHSIZE</batchsize>
    <newConnectionPerTxn>BENCHBASE_NEWCONNPERTXN</newConnectionPerTxn>

    <!-- Scalefactor in SEATS scales by *1000 the number of customers-->
    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>10, 10, 35, 20, 10, 15</weights>
        </work>
    </works>

    <!-- SEATS Procedures declaration -->
    <transactiontypes>
        <transactiontype>
            <name>DeleteReservation</name>
        </transactiontype>
        <transactiontype>
            <name>FindFlights</name>
        </transactiontype>
        <transactiontype>
            <name>FindOpenSeats</name>
        </transactiontype>
        <transactiontype>
            <name>NewReservation</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateCustomer</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateReservation</name>
        </transactiontype>
    </transactiontypes>
</parameters>
