<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>MYSQL</type>
    <driver>com.mysql.cj.jdbc.Driver</driver>
    <url>jdbc:mysql://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE?rewriteBatchedStatements=true&amp;sslMode=DISABLED&amp;useSSL=false&amp;allowPublicKeyRetrieval=true</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>
    <isolation>BENCHBASE_ISOLATION</isolation>
    <batchsize>BENCHBASE_BATCHSIZE</batchsize>
    <newConnectionPerTxn>BENCHBASE_NEWCONNPERTXN</newConnectionPerTxn>

    <!-- Scalefactor in YCSB is *1000 the number of rows in the USERTABLE-->
    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>BENCHBASE_YCSB_WEIGHTS</weights>
        </work>
    </works>

    <!-- YCSB Procedures declaration -->
    <transactiontypes>
        <transactiontype>
            <name>ReadRecord</name>
        </transactiontype>
        <transactiontype>
            <name>InsertRecord</name>
        </transactiontype>
        <transactiontype>
            <name>ScanRecord</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateRecord</name>
        </transactiontype>
        <transactiontype>
            <name>DeleteRecord</name>
        </transactiontype>
        <transactiontype>
            <name>ReadModifyWriteRecord</name>
        </transactiontype>
    </transactiontypes>
</parameters>
