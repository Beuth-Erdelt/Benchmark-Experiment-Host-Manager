<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>MYSQL</type>
    <driver>com.mysql.cj.jdbc.Driver</driver>
    <url>jdbc:mysql://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE?rewriteBatchedStatements=true&amp;sslMode=DISABLED&amp;useSSL=false&amp;allowPublicKeyRetrieval=true</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>

    <batchsize>BENCHBASE_BATCHSIZE</batchsize>
    <newConnectionPerTxn>BENCHBASE_NEWCONNPERTXN</newConnectionPerTxn>
    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>100</weights>
        </work>
    </works>

    <!-- Transaction Declaration -->
    <transactiontypes>
        <transactiontype>
            <name>GetSessionRange</name>
        </transactiontype>
    </transactiontypes>
</parameters>
