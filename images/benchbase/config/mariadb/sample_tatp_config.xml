<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>MARIADB</type>
    <driver>org.mariadb.jdbc.Driver</driver>
    <url>jdbc:mariadb://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE?useServerPrepStmts</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>
    <isolation>BENCHBASE_ISOLATION</isolation>
    <batchsize>BENCHBASE_BATCHSIZE</batchsize>
    <newConnectionPerTxn>BENCHBASE_NEWCONNPERTXN</newConnectionPerTxn>

    <!-- Scalefactor increases the number of subscribers -->
    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>2, 35, 10, 35, 2, 14, 2</weights>
        </work>
    </works>

    <!-- Twitter Procedures declaration -->
    <transactiontypes>
        <transactiontype>
            <name>DeleteCallForwarding</name>
        </transactiontype>
        <transactiontype>
            <name>GetAccessData</name>
        </transactiontype>
        <transactiontype>
            <name>GetNewDestination</name>
        </transactiontype>
        <transactiontype>
            <name>GetSubscriberData</name>
        </transactiontype>
        <transactiontype>
            <name>InsertCallForwarding</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateLocation</name>
        </transactiontype>
        <transactiontype>
            <name>UpdateSubscriberData</name>
        </transactiontype>
    </transactiontypes>
</parameters>
