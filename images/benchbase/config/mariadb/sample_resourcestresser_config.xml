<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>MARIADB</type>
    <driver>org.mariadb.jdbc.Driver</driver>
    <url>jdbc:mariadb://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE?useServerPrepStmts</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>
    <isolation>BENCHBASE_ISOLATION</isolation>
    <batchsize>BENCHBASE_BATCHSIZE</batchsize>
    <newConnectionPerTxn>BENCHBASE_NEWCONNPERTXN</newConnectionPerTxn>

    <!-- Scalefactor in ResourceStresser scales by *100 the number of employees -->
    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>16.66,16.66,16.66,16.66,16.66,16.7</weights>
        </work>
    </works>

    <!-- R/S Procedures declaration -->
    <transactiontypes>
        <transactiontype>
            <name>CPU1</name>
        </transactiontype>
        <transactiontype>
            <name>CPU2</name>
        </transactiontype>
        <transactiontype>
            <name>IO1</name>
        </transactiontype>
        <transactiontype>
            <name>IO2</name>
        </transactiontype>
        <transactiontype>
            <name>Contention1</name>
        </transactiontype>
        <transactiontype>
            <name>Contention2</name>
        </transactiontype>
    </transactiontypes>

</parameters>
