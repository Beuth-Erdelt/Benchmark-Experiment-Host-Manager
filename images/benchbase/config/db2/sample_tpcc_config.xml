<?xml version="1.0"?>
<parameters>

    <!-- Connection details: the database of IBM Db2 (BEXHOMA_DATABASE, bexhoma); the tables are created in
         the default schema of the user (BEXHOMA_USER, db2inst1). The driver is downloaded at the start
         into profiles/db2/lib (BEXHOMA_JAR_URL), it is not part of the image -->
    <type>DB2</type>
    <driver>com.ibm.db2.jcc.DB2Driver</driver>
    <url>jdbc:db2://BEXHOMA_HOST:BEXHOMA_PORT/BEXHOMA_DATABASE</url>
    <username>BEXHOMA_USER</username>
    <password>BEXHOMA_PASSWORD</password>
    <isolation>BENCHBASE_ISOLATION</isolation>
    <batchsize>BENCHBASE_BATCHSIZE</batchsize>

    <!-- Scale factor is the number of warehouses in TPCC -->
    <scalefactor>BEXHOMA_SF</scalefactor>

    <!-- The workload -->
    <terminals>BENCHBASE_TERMINALS</terminals>
    <works>
        <work>
            <time>BENCHBASE_TIME</time>
            <warmup>BENCHBASE_WARMUP</warmup>
            <rate>BENCHBASE_TARGET</rate>
            <weights>45,43,4,4,4</weights>
        </work>
    </works>

    <!-- TPCC specific -->
    <transactiontypes>
        <transactiontype>
            <name>NewOrder</name>
            <!--<preExecutionWait>18000</preExecutionWait>-->
            <!--<postExecutionWait>12000</postExecutionWait>-->
        </transactiontype>
        <transactiontype>
            <name>Payment</name>
            <!--<preExecutionWait>3000</preExecutionWait>-->
            <!--<postExecutionWait>12000</postExecutionWait>-->
        </transactiontype>
        <transactiontype>
            <name>OrderStatus</name>
            <!--<preExecutionWait>2000</preExecutionWait>-->
            <!--<postExecutionWait>10000</postExecutionWait>-->
        </transactiontype>
        <transactiontype>
            <name>Delivery</name>
            <!--<preExecutionWait>2000</preExecutionWait>-->
            <!--<postExecutionWait>5000</postExecutionWait>-->
        </transactiontype>
        <transactiontype>
            <name>StockLevel</name>
            <!--<preExecutionWait>2000</preExecutionWait>-->
            <!--<postExecutionWait>5000</postExecutionWait>-->
        </transactiontype>
    </transactiontypes>
</parameters>
