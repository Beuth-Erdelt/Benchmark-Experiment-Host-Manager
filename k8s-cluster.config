                    'eval_parameters': {'BEXHOMA_REPLICAS': '{num_worker_replicas}', 'BEXHOMA_SHARDS': '{num_worker_shards}', 'BEXHOMA_WORKERS': '{num_worker}'},                                         # parameters stored with the results
