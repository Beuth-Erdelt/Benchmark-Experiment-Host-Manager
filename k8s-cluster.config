                    'reset_scripts': ['save-snapshot.sh'],                                                                                                         # scripts run before each benchmarking round (-ar)
                    'sut_parameters': {'BEXHOMA_REPLICAS': '{num_worker_replicas}', 'BEXHOMA_SHARDS': '{num_worker_shards}'},                                      # environment of the SUT container (a value set by the experiment wins)
                    'eval_parameters': {'BEXHOMA_REPLICAS': '{num_worker_replicas}', 'BEXHOMA_SHARDS': '{num_worker_shards}', 'BEXHOMA_WORKERS': '{num_worker}'},  # parameters stored with the results
                    'loading_parameters': {'BEXHOMA_DBMS_TYPE': 'cassandra', 'BEXHOMA_REPLICAS': '{num_worker_replicas}'},                                         # environment of the loading jobs
                    'benchmarking_parameters': {'BEXHOMA_DBMS_TYPE': 'cassandra', 'BEXHOMA_REPLICAS': '{num_worker_replicas}'},                                    # environment of the benchmarking jobs
                    'variants': [                                                                                                                                  # changes that depend on the command line, applied in order when 'when' holds
