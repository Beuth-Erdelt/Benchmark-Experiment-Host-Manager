{
    'benchmarker': {
        'resultfolder': '/home/myself/benchmarks',
        'jarfolder': './jars/'
    },
    'credentials': {
        'k8s': {
            'appname': 'bexhoma',
            'context': {
                'dummy': {
                    'namespace': 'dummy',
                    'clustername': 'Dummy',
                    'service_sut': '{service}.{namespace}.svc.cluster.local',
                    'port': 9091, # K8s: Local port for connecting via JDBC after port forwarding
                    'storage_classes': [], # StorageClass names available in this cluster for --request-storage-type, e.g. ['local-hdd', 'shared', 'cephcsi']
                },
            },
            'monitor': {
                'service_monitoring': 'http://prometheus.monitor.svc.cluster.local:9090/api/v1/',
                'service_monitoring_application': 'http://{service}.{namespace}.svc.cluster.local:9090/api/v1/',
                'extend': 0,
                'shift': 0,
                'scrape_interval': 30, # seconds between two scrapes of the cluster Prometheus; shorter phases are not measurable (see docs/Monitoring.md)
                'metrics': {
                    'total_cpu_memory': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        'query': '(sum(max((container_memory_working_set_bytes{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_memory_working_set_bytes{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90)) by (instance)))/1024/1024',
                        'title': 'Memory Usage, Working Set [MiB]'
                    },
                    'total_cpu_memory_cached': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        'query': '(sum(max((container_memory_usage_bytes{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_memory_usage_bytes{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90)) by (instance)))/1024/1024',
                        'title': 'Memory Usage incl. Page Cache [MiB]'
                    },
                    'total_cpu_util': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        'query': 'sum(irate(container_cpu_usage_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}}[5m]))',
                        'title': 'CPU Utilization [CPUs]'
                    },
                    'total_cpu_throttled': {
                        'type': 'cluster',
                        'active': True,
                        # no series while the value is 0: no data means 0, not a monitoring gap
                        'sparse': True,
                        'metric': 'gauge',
                        'query': 'sum(irate(container_cpu_cfs_throttled_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}}[5m]))',
                        'title': 'CPU Throttling Rate [s/s]'
                    },
                    'total_cpu_throttled_s': {
                        'type': 'cluster',
                        'active': True,
                        # no series while the value is 0: no data means 0, not a monitoring gap
                        'sparse': True,
                        'metric': 'counter',
                        'query': 'sum((container_cpu_cfs_throttled_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_cpu_cfs_throttled_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90))',
                        'title': 'CPU Throttled Time [s]'
                    },
                    'total_cpu_util_others': {
                        'type': 'cluster',
                        'active': False,
                        'metric': 'gauge',
                        'query': 'sum(irate(container_cpu_usage_seconds_total{{pod=~"{pods}", namespace="{namespace}", container!="dbms",id!="/"}}[5m]))',
                        'title': 'CPU Utilization Others [CPUs]'
                    },
                    'total_cpu_util_s': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'sum((container_cpu_usage_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_cpu_usage_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90))',
                        'title': 'CPU Utilization Time [s]'
                    },
                    'total_cpu_util_user_s': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'sum((container_cpu_user_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_cpu_user_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90))',
                        'title': 'CPU User Time [s]'
                    },
                    'total_cpu_util_sys_s': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'sum((container_cpu_system_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_cpu_system_seconds_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90))',
                        'title': 'CPU System Time [s]'
                    },
                    'total_cpu_util_others_s': {
                        'type': 'cluster',
                        'active': False,
                        'metric': 'counter',
                        'query': 'sum((container_cpu_usage_seconds_total{{pod=~"{pods}", namespace="{namespace}", container!="dbms",id!="/"}} and (time() - timestamp(container_cpu_usage_seconds_total{{pod=~"{pods}", namespace="{namespace}", container!="dbms",id!="/"}})) < 90))',
                        'title': 'CPU Utilization Time Others [s]'
                    },
                    'total_network_rx': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'sum((container_network_receive_bytes_total{{pod=~"{pods}", namespace="{namespace}"}} and (time() - timestamp(container_network_receive_bytes_total{{pod=~"{pods}", namespace="{namespace}"}})) < 90))/1024/1024',
                        'title': 'Network Rx Total [MiB]'
                    },
                    'total_network_tx': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'sum((container_network_transmit_bytes_total{{pod=~"{pods}", namespace="{namespace}"}} and (time() - timestamp(container_network_transmit_bytes_total{{pod=~"{pods}", namespace="{namespace}"}})) < 90))/1024/1024',
                        'title': 'Network Tx Total [MiB]'
                    },
                    'total_fs_read': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        # cAdvisor reports a RAID device and each of its member disks, so summing
                        # over devices would count every write several times: take the largest
                        # device per pod, then sum over pods.
                        # a client or proxy (pool) container's series only appears once it does disk I/O
                        'sparse_components': ['loader', 'benchmarker', 'datagenerator', 'poolloading', 'poolbenchmarking'],
                        # a DBMS container without disk I/O has no series either: a warning, not a failure,
                        # when CPU utilization shows its pods were scraped (an in-memory DBMS)
                        'activity_dependent': 'total_cpu_util',
                        'query': 'sum(max by (pod) ((container_fs_reads_bytes_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_fs_reads_bytes_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90)))/1024/1024',
                        'title': 'Filesystem Read Total, Largest Device (RAID Counted Once) [MiB]'
                    },
                    'total_fs_write': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        # cAdvisor reports a RAID device and each of its member disks, so summing
                        # over devices would count every write several times: take the largest
                        # device per pod, then sum over pods.
                        # a client or proxy (pool) container's series only appears once it does disk I/O
                        'sparse_components': ['loader', 'benchmarker', 'datagenerator', 'poolloading', 'poolbenchmarking'],
                        # a DBMS container without disk I/O has no series either: a warning, not a failure,
                        # when CPU utilization shows its pods were scraped (an in-memory DBMS)
                        'activity_dependent': 'total_cpu_util',
                        'query': 'sum(max by (pod) ((container_fs_writes_bytes_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}} and (time() - timestamp(container_fs_writes_bytes_total{{pod=~"{pods}", namespace="{namespace}", container="dbms"}})) < 90)))/1024/1024',
                        'title': 'Filesystem Write Total, Largest Device (RAID Counted Once) [MiB]'
                    },
                    'total_gpu_util': {
                        'type': 'cluster',
                        'active': False,
                        'metric': 'gauge',
                        'query': 'sum(DCGM_FI_DEV_GPU_UTIL{{UUID=~"{gpuid}"}})',
                        'title': 'GPU Utilization, Sum over GPUs [%]'
                    },
                    'total_gpu_power': {
                        'type': 'cluster',
                        'active': False,
                        'metric': 'gauge',
                        'query': 'sum(DCGM_FI_DEV_POWER_USAGE{{UUID=~"{gpuid}"}})',
                        'title': 'GPU Power Usage, Sum over GPUs [W]'
                    },
                    'total_gpu_memory': {
                        'type': 'cluster',
                        'active': False,
                        'metric': 'gauge',
                        'query': 'sum(DCGM_FI_DEV_FB_USED{{UUID=~"{gpuid}"}})',
                        'title': 'GPU Memory Usage, Sum over GPUs [MiB]'
                    },
                    'core_variance': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'ratio',
                        # variance of the per-core busy share, in percent squared (busy share in % per core)
                        'query': '10000 * (avg((sum by (exported_cpu) (rate(node_cpu_seconds_total{{mode!="idle", instance="{host}"}}[5m])))^2)-(avg(sum by (exported_cpu) (rate(node_cpu_seconds_total{{mode!="idle", instance="{host}"}}[5m]))))^2)',
                        'title': 'Node Core Utilization Variance [%^2]'
                    },
                    'max_core_util': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'ratio',
                        'query': '100 * max(sum by (exported_cpu) (rate(node_cpu_seconds_total{{mode!="idle", instance="{host}"}}[5m])))',
                        'title': 'Node Max Core Utilization [%]'
                    },
                    'io_wait_pct': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'ratio',
                        'query': '100 * sum by (instance) (rate(node_cpu_seconds_total{{mode="iowait", instance="{host}"}}[5m])) / sum by (instance) (rate(node_cpu_seconds_total{{mode!="idle", instance="{host}"}}[5m]))',
                        'title': 'Node I/O Wait, Share of Busy CPU Time [%]'
                    },
                    'io_wait_total': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter', # but not summed over all containers
                        'query': 'sum(node_cpu_seconds_total{{instance="{host}", mode="iowait"}})',
                        'title': 'Node I/O Wait CPU Time [s]'
                    },
                    # Ceph storage of the SUT's volume (see docs/Monitoring.md). {pool} and {rbd_images}
                    # are filled per configuration from its PVC; on storage without them (ephemeral,
                    # ramdisk, non-Ceph classes, CephFS for per-volume metrics) the metric is switched off.
                    # The Ceph exporter's counters lag the I/O by about 1-2 minutes.
                    # --- the Ceph pool behind the storage class, all clients (shared across configurations) ---
                    'ceph_pool_write': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'max(max by (pool_id) (ceph_pool_wr_bytes{{pool_id!=""}}) * on(pool_id) group_left(name) max by (pool_id, name) (ceph_pool_metadata{{name="{pool}"}}))/1024/1024',
                        'title': 'Ceph Pool Write, All Clients [MiB]'
                    },
                    'ceph_pool_write_ops': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'max(max by (pool_id) (ceph_pool_wr{{pool_id!=""}}) * on(pool_id) group_left(name) max by (pool_id, name) (ceph_pool_metadata{{name="{pool}"}}))',
                        'title': 'Ceph Pool Write Operations, All Clients [ops]'
                    },
                    'ceph_pool_read': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'max(max by (pool_id) (ceph_pool_rd_bytes{{pool_id!=""}}) * on(pool_id) group_left(name) max by (pool_id, name) (ceph_pool_metadata{{name="{pool}"}}))/1024/1024',
                        'title': 'Ceph Pool Read, All Clients [MiB]'
                    },
                    'ceph_pool_read_ops': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'max(max by (pool_id) (ceph_pool_rd{{pool_id!=""}}) * on(pool_id) group_left(name) max by (pool_id, name) (ceph_pool_metadata{{name="{pool}"}}))',
                        'title': 'Ceph Pool Read Operations, All Clients [ops]'
                    },
                    # --- the SUT's own RBD volume(s); 0 until a new image shows up in the exporter ---
                    'ceph_volume_write': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': '(sum(max by (image) (ceph_rbd_write_bytes{{pool="{pool}", image=~"{rbd_images}"}})) or on() (0 * max(ceph_pool_metadata{{name="{pool}"}})))/1024/1024',
                        'title': 'Ceph Volume Write, This SUT [MiB]'
                    },
                    'ceph_volume_write_ops': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'sum(max by (image) (ceph_rbd_write_ops{{pool="{pool}", image=~"{rbd_images}"}})) or on() (0 * max(ceph_pool_metadata{{name="{pool}"}}))',
                        'title': 'Ceph Volume Write Operations, This SUT [ops]'
                    },
                    'ceph_volume_read': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': '(sum(max by (image) (ceph_rbd_read_bytes{{pool="{pool}", image=~"{rbd_images}"}})) or on() (0 * max(ceph_pool_metadata{{name="{pool}"}})))/1024/1024',
                        'title': 'Ceph Volume Read, This SUT [MiB]'
                    },
                    'ceph_volume_read_ops': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'counter',
                        'query': 'sum(max by (image) (ceph_rbd_read_ops{{pool="{pool}", image=~"{rbd_images}"}})) or on() (0 * max(ceph_pool_metadata{{name="{pool}"}}))',
                        'title': 'Ceph Volume Read Operations, This SUT [ops]'
                    },
                    'ceph_volume_write_latency': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        # nanoseconds in the exporter; NaN while the volume is idle (0/0), which the phase mean skips
                        'query': 'sum(max by (image) (rate(ceph_rbd_write_latency_sum{{pool="{pool}", image=~"{rbd_images}"}}[2m]))) / sum(max by (image) (rate(ceph_rbd_write_latency_count{{pool="{pool}", image=~"{rbd_images}"}}[2m]))) / 1e6',
                        'title': 'Ceph Volume Write Latency, This SUT [ms]'
                    },
                    'ceph_volume_read_latency': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        'query': 'sum(max by (image) (rate(ceph_rbd_read_latency_sum{{pool="{pool}", image=~"{rbd_images}"}}[2m]))) / sum(max by (image) (rate(ceph_rbd_read_latency_count{{pool="{pool}", image=~"{rbd_images}"}}[2m]))) / 1e6',
                        'title': 'Ceph Volume Read Latency, This SUT [ms]'
                    },
                    # --- every other volume in the same pool (shared across configurations) ---
                    'ceph_others_write_rate': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        'query': '(sum(max by (image) (rate(ceph_rbd_write_bytes{{pool="{pool}", image!~"{rbd_images}"}}[2m]))) or on() (0 * max(ceph_pool_metadata{{name="{pool}"}})))/1024/1024',
                        'title': 'Ceph Pool Write Rate, Other Volumes [MiB/s]'
                    },
                    'ceph_others_write_ops_rate': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        'query': 'sum(max by (image) (rate(ceph_rbd_write_ops{{pool="{pool}", image!~"{rbd_images}"}}[2m]))) or on() (0 * max(ceph_pool_metadata{{name="{pool}"}}))',
                        'title': 'Ceph Pool Write Operations Rate, Other Volumes [ops/s]'
                    },
                    'ceph_others_read_ops_rate': {
                        'type': 'cluster',
                        'active': True,
                        'metric': 'gauge',
                        'query': 'sum(max by (image) (rate(ceph_rbd_read_ops{{pool="{pool}", image!~"{rbd_images}"}}[2m]))) or on() (0 * max(ceph_pool_metadata{{name="{pool}"}}))',
                        'title': 'Ceph Pool Read Operations Rate, Other Volumes [ops/s]'
                    },
                },
                'pd': {
                    'metrics': {
                        # PD cluster leader count — should normally be 1; changes indicate elections.
                        'pd_cluster_leader_count': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'pd_cluster_status{{type="leader_count"}}',
                            'title': 'PD Cluster Leader Count'
                        },
                        # Number of PD scheduler leader balance operations.
                        'pd_scheduler_balance_leader_actions': {
                            'type': 'application',
                            'active': True,
                            # no series before PD's first leader balance: no data means 0, not a monitoring gap
                            'sparse': True,
                            'metric': 'counter',
                            'query': 'sum(pd_scheduler_balance_leader)',
                            'title': 'PD Leader Balance Actions [count]'
                        },
                        # Number of PD scheduler leader balance operations per second.
                        #'pd_scheduler_balance_leader_rate': {
                        #    'type': 'application',
                        #    'active': True,
                        #    'metric': 'gauge',
                        #    'query': 'rate(pd_scheduler_balance_leader[5m])',
                        #    'title': 'PD Leader Balance Actions [ops/s]'
                        #},
                    },
                },
                'tidb': {
                    'metrics': {
                        # Total SQL statements executed per second (SELECT, UPDATE, INSERT, ...)
                        'tidb_sql_statement_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(tidb_executor_statement_total[5m]))',
                            'title': 'TiDB SQL Statement Throughput [ops/s]'
                        },
                        # Average TiDB query execution duration (latency)
                        'tidb_query_duration_avg': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': '1000*sum(tidb_server_handle_query_duration_seconds_sum) / sum(tidb_server_handle_query_duration_seconds_count)',
                            'title': 'TiDB Avg Query Duration since Start [ms]'
                        },
                    },
                },
                'tikv': {
                    'metrics': {
                        # TiKV store size used in Gi, a key indicator of region/data distribution
                        'tikv_store_used_bytes': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(tikv_store_size_bytes{{type="used"}})/1024/1024/1024',
                            'title': 'TiKV Store Size Used [GiB]'
                        },
                        # TiKV store size used in percent, a key indicator of region/data distribution
                        'tikv_store_size_bytes': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(tikv_store_size_bytes{{type="used"}})/sum(tikv_store_size_bytes{{type="capacity"}})*100',
                            'title': 'TiKV Store Used [%]'
                        },
                        # RocksDB compaction duration — heavy indicator of TiKV disk load
                        'tikv_compaction_time': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            # median of RocksDB's compaction time histogram, reported in microseconds
                            'query': 'max(tikv_engine_compaction_time{{type="compaction_time_median"}})/1000000',
                            'title': 'TiKV Compaction Time Median, Max over Instances [s]'
                        },
                        # RocksDB compaction duration — heavy indicator of TiKV disk load
                        'tikv_compaction_flow': {
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            'query': 'sum(tikv_engine_compaction_flow_bytes)/1024/1024/1024',
                            'title': 'TiKV Compaction Flow [GiB]'
                        },
                        # RocksDB compaction duration — heavy indicator of TiKV disk load
                        'tikv_compaction_pending': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(tikv_engine_pending_compaction_bytes)/1024/1024/1024',
                            'title': 'TiKV Compaction Pending [GiB]'
                        }
                    }
                },
                'yb-master': {
                    'metrics': {
                        'yb_master_rpc_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': (
                                'sum(rate(handler_latency_yb_master_MasterClient_GetTabletLocations_count[5m])) + '
                                'sum(rate(handler_latency_yb_master_MasterDdl_CreateTable_count[5m])) + '
                                'sum(rate(handler_latency_yb_master_MasterDdl_DeleteTable_count[5m]))'
                            ),
                            'title': 'YB-Master RPC Throughput [ops/s]'
                        },
                        'yb_master_rpc_latency_avg': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': (
                                '('
                                '(sum(handler_latency_yb_master_MasterClient_GetTabletLocations_sum) + '
                                ' sum(handler_latency_yb_master_MasterDdl_CreateTable_sum) + '
                                ' sum(handler_latency_yb_master_MasterDdl_DeleteTable_sum)) / '
                                '(sum(handler_latency_yb_master_MasterClient_GetTabletLocations_count) + '
                                ' sum(handler_latency_yb_master_MasterDdl_CreateTable_count) + '
                                ' sum(handler_latency_yb_master_MasterDdl_DeleteTable_count))'
                                ') / 1000'
                            ),
                            'title': 'YB-Master Avg RPC Latency since Start [ms]'
                        },
                        'yb_master_table_metadata_ops': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': (
                                'sum(rate(handler_latency_yb_master_MasterDdl_CreateTable_count[5m])) + '
                                'sum(rate(handler_latency_yb_master_MasterDdl_DeleteTable_count[5m]))'
                            ),
                            'title': 'Table Metadata Operations [ops/s]'
                        },
                        'yb_master_clock_error': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            # hybrid_clock_error is reported in microseconds
                            'query': 'max(hybrid_clock_error)/1000',
                            'title': 'YB-Master Clock Error [ms]'
                        },
                        'yb_master_tablet_location_requests': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(handler_latency_yb_master_MasterClient_GetTabletLocations_count[5m]))',
                            'title': 'Tablet Location Requests [ops/s]'
                        }
                    }
                },
                'yb-tserver': {
                    'metrics': {
                        'yb_tserver_ysql_query_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': (
                                'sum(rate(handler_latency_yb_tserver_TabletServerService_Read_count[5m])) + '
                                'sum(rate(handler_latency_yb_tserver_TabletServerService_Write_count[5m]))'
                            ),
                            'title': 'Tablet Read+Write RPC Throughput [ops/s]'
                        },
                        'yb_tserver_read_latency_avg': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': (
                                'sum(handler_latency_yb_tserver_TabletServerService_Read_sum) /'
                                'sum(handler_latency_yb_tserver_TabletServerService_Read_count)'
                                '/ 1000'
                            ),
                            'title': 'Tablet Read Latency, Avg since Start [ms]'
                        },
                        'yb_tserver_write_latency_avg': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': (
                                'sum(handler_latency_yb_tserver_TabletServerService_Write_sum) / '
                                'sum(handler_latency_yb_tserver_TabletServerService_Write_count)'
                                '/ 1000'
                            ),
                            'title': 'Tablet Write Latency, Avg since Start [ms]'
                        },
                        'yb_tserver_ysql_connections': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(yb_ysqlserver_active_connection_total)',
                            'title': 'Active YSQL Connections'
                        },
                        'yb_tserver_follower_lag': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'max(follower_lag_ms)',
                            'title': 'TServer Follower Lag [ms]'
                        }
                    }
                },
                'dragonfly': {
                    'metrics': {
                        'dragonfly_reply_total': {
                            # Gesamtzahl aller an Clients gesendeten Antworten (Replies)
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            'query': 'sum(dragonfly_reply_total)',
                            'title': 'Replies Sent [count]'
                        },
                        'dragonfly_memory_used_bytes': {
                            # Aktuell genutzter Arbeitsspeicher des Servers
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(dragonfly_memory_used_bytes)/1024/1024/1024',
                            'title': 'Memory Usage [GiB]'
                        },
                        'dragonfly_commands_processed_total': {
                            # Gesamtzahl aller verarbeiteten Kommandos (Request Load)
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(dragonfly_commands_processed_total[5m]))',
                            'title': 'Processed Commands [ops/s]'
                        },
                        'dragonfly_net_input_bytes_total': {
                            # Eingehende Netzwerkdaten von Clients
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(dragonfly_net_input_bytes_total[5m]))/1024/1024',
                            'title': 'Network Input [MiB/s]'
                        },
                        'dragonfly_connected_replica_lag_records': {
                            # Rückstand eines Replicas in Datensätzen
                            'type': 'application',
                            'active': True,
                            # no series without replicas: no data means no replication, not a monitoring gap
                            'sparse': True,
                            'metric': 'gauge',
                            'query': 'sum(dragonfly_connected_replica_lag_records)',
                            'title': 'Replica Lag [records]'
                        },
                        'dragonfly_moved_errors_total': {
                            # Anzahl der Slot-Migrationsfehler im Cluster
                            'type': 'application',
                            'active': True,
                            # no series until the first moved error: no data means 0, not a monitoring gap
                            'sparse': True,
                            'metric': 'counter',
                            'query': 'sum(dragonfly_moved_errors_total)',
                            'title': 'Cluster Slot Moved Errors [count]'
                        },
                        'dragonfly_replication_streaming_bytes': {
                            # Speicherverbrauch für laufende Streaming-Replikation
                            'type': 'application',
                            'active': True,
                            # no series without replicas: no data means no replication, not a monitoring gap
                            'sparse': True,
                            'metric': 'gauge',
                            'query': 'sum(dragonfly_replication_streaming_bytes)/1024/1024/1024',
                            'title': 'Replication Streaming Memory [GiB]'
                        },
                        'dragonfly_replication_full_sync_bytes': {
                            # Speicherverbrauch während voller Synchronisation (Full Sync)
                            'type': 'application',
                            'active': True,
                            # no series without replicas: no data means no replication, not a monitoring gap
                            'sparse': True,
                            'metric': 'gauge',
                            'query': 'sum(dragonfly_replication_full_sync_bytes)/1024/1024/1024',
                            'title': 'Full Sync Replication Memory [GiB]'
                        },
                        'dragonfly_replication_psync_count': {
                            # Anzahl der PSYNC-Replikationsereignisse
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            'query': 'sum(dragonfly_replication_psync_count)',
                            'title': 'PSync Events [count]'
                        },
                    }
                },
                'redis': {
                    'metrics': {
                        # Redis cluster state — 1 means healthy, 0 means fail.
                        'redis_cluster_state': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(redis_cluster_state)', # or min(redis_cluster_state)
                            'title': 'Redis Cluster State'
                        },
                        # Connected clients — sudden spikes may indicate traffic surge or connection leaks.
                        'redis_connected_clients': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(redis_connected_clients)',
                            'title': 'Connected Clients [count]'
                        },
                        # Memory usage — critical for avoiding eviction or OOM.
                        'redis_memory_used_bytes': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(redis_memory_used_bytes)/1024/1024/1024',
                            'title': 'Redis Memory Used [GiB]'
                        },
                        # Replication health — 0 means replication link down.
                        'redis_master_link_up': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(redis_master_link_up)', # or sum(redis_master_link_up == 0)
                            'title': 'Redis Master Link Status'
                        },
                        # Commands processed per second — core throughput indicator.
                        'redis_ops_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'max(rate(redis_commands_processed_total[5m]))',
                            'title': 'Redis Operations Rate, Busiest Instance [ops/s]'
                        },
                        'redis_keyspace_hit_ratio': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(increase(redis_keyspace_hits_total[5m]))/(sum(increase(redis_keyspace_hits_total[5m])) + sum(increase(redis_keyspace_misses_total[5m])))',
                            'title': 'Keyspace Hit Ratio [0..1]'
                        },
                        'redis_replica_lag_seconds': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'max(redis_connected_slave_lag_seconds)',
                            'title': 'Replication Lag (max across replicas) [s]'
                        },
                        'redis_replica_count': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(redis_connected_slaves)',
                            'title': 'Number of replicas [count]'
                        },
                    },
                },
                'cassandra': {
                    'metrics': {
                        # Read requests per second of the coordinators.
                        'cassandra_read_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(irate(cassandra_stats{{name="org:apache:cassandra:metrics:clientrequest:read:latency:count"}}[5m]))',
                            'title': 'Read Requests [ops/s]'
                        },
                        # Write requests per second of the coordinators.
                        'cassandra_write_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(irate(cassandra_stats{{name="org:apache:cassandra:metrics:clientrequest:write:latency:count"}}[5m]))',
                            'title': 'Write Requests [ops/s]'
                        },
                        'cassandra_read_latency_p99': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'max(cassandra_stats{{name="org:apache:cassandra:metrics:clientrequest:read:latency:99thpercentile"}})/1000',
                            'title': 'Read Latency p99, Slowest Node [ms]'
                        },
                        'cassandra_write_latency_p99': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'max(cassandra_stats{{name="org:apache:cassandra:metrics:clientrequest:write:latency:99thpercentile"}})/1000',
                            'title': 'Write Latency p99, Slowest Node [ms]'
                        },
                        # Requests that failed on the server side: not visible as latency.
                        'cassandra_timeouts': {
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            'query': 'sum(cassandra_stats{{name=~"org:apache:cassandra:metrics:clientrequest:(read|write):timeouts:count"}})',
                            'title': 'Read and Write Timeouts [count]'
                        },
                        'cassandra_unavailables': {
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            'query': 'sum(cassandra_stats{{name=~"org:apache:cassandra:metrics:clientrequest:(read|write):unavailables:count"}})',
                            'title': 'Read and Write Unavailables [count]'
                        },
                        # Compaction backlog: reads get slower while it grows.
                        'cassandra_compaction_pending': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(cassandra_stats{{name="org:apache:cassandra:metrics:compaction:pendingtasks:value"}})',
                            'title': 'Pending Compactions [count]'
                        },
                        'cassandra_sstables': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(cassandra_stats{{name="org:apache:cassandra:metrics:table:ycsb:usertable:livesstablecount:value"}})',
                            'title': 'Live SSTables of usertable [count]'
                        },
                        'cassandra_mutation_pending': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(cassandra_stats{{name="org:apache:cassandra:metrics:threadpools:request:mutationstage:pendingtasks:value"}})',
                            'title': 'Pending Mutations [count]'
                        },
                        'cassandra_read_pending': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(cassandra_stats{{name="org:apache:cassandra:metrics:threadpools:request:readstage:pendingtasks:value"}})',
                            'title': 'Pending Reads [count]'
                        },
                        'cassandra_keycache_hit_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'avg(cassandra_stats{{name="org:apache:cassandra:metrics:cache:keycache:oneminutehitrate:value"}})',
                            'title': 'Key Cache Hit Rate [0..1]'
                        },
                        # Live SSTables on disk, replicas included.
                        'cassandra_load': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(cassandra_stats{{name="org:apache:cassandra:metrics:storage:load:count"}})/1024/1024/1024',
                            'title': 'Data on Disk [GiB]'
                        },
                        'cassandra_commitlog_size': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(cassandra_stats{{name="org:apache:cassandra:metrics:commitlog:totalcommitlogsize:value"}})/1024/1024/1024',
                            'title': 'Commit Log Size [GiB]'
                        },
                    },
                },
                'cockroachdb': {
                    'metrics': {
                        # Rate of Raft MsgAppResp messages received per second, a core indicator of Raft protocol traffic and health
                        'raft_messages_received_appresp_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(raft_rcvd_appresp[5m]))',
                            'title': 'Raft Messages Received (AppResp) [msgs/s]'
                        },
                        # Rate of all Raft message bytes received per second, indicating network load from the Raft protocol
                        'raft_network_in_bytes_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(raft_rcvd_bytes[5m]))',
                            'title': 'Raft Network In [B/s]'
                        },
                        # Rate of bytes received from Raft recovery snapshots per second, indicating ongoing range repair or re-replication activity
                        'raft_recovery_snapshot_in_bytes_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(range_snapshots_recovery_rcvd_bytes[5m]))',
                            'title': 'Raft Recovery Snapshot In [B/s]'
                        },
                        # Rate of replica additions attempted by the replicate queue per second, indicating balancing attempts
                        'replicate_queue_add_replica_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(queue_replicate_addreplica[5m]))',
                            'title': 'Replicate Queue Adds Attempted [adds/s]'
                        },
                        # Total count of replicas currently stalled in the replicate queue's purgatory, waiting for allocation options
                        'replicate_queue_purgatory_count': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(queue_replicate_purgatory)',
                            'title': 'Replicate Queue Purgatory Count'
                        },
                        # Rate of times the allocator found a valid lease transfer candidate that was not on an overfull store
                        'lease_transfer_existing_not_overfull_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(kv_allocator_load_based_lease_transfers_existing_not_overfull[5m]))',
                            'title': 'Lease Transfer Not Overfull Rate [events/s]'
                        },
                        # Rate of occurrences where an overfull store failed to shed load after exhausting rebalance options
                        'rebalancing_overfull_options_exhausted_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(rebalancing_state_imbalanced_overfull_options_exhausted[5m]))',
                            'title': 'Rebalancing Overfull Options Exhausted Rate [events/s]'
                        },
                        # Total number of healthy, bidirectionally connected RPC connections across the cluster
                        'rpc_healthy_connections_count': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rpc_connection_healthy)',
                            'title': 'Healthy RPC Connections'
                        },
                        # Rate of TransactionRetryWithProtoRefreshErrType errors, indicating high transaction contention or restarts
                        'distsender_rpc_err_transactionretrywithprotorefresherrtype_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(distsender_rpc_err_transactionretrywithprotorefresherrtype[5m]))',
                            'title': 'DistSender Transaction Retry Error Rate [errors/s]'
                        },
                        # Total number of bytes taken up by all values stored across the entire cluster, a key capacity metric
                        'total_data_size_bytes': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(valbytes)',
                            'title': 'Total Stored Data Size [B]'
                        },
                    },
                },
                'clickhouse': {
                    # ClickHouse's own Prometheus endpoint (port 9363, set in the templates);
                    # summed over all scraped pods (cluster: coordinator and shards, so a
                    # distributed query counts once on the coordinator and once per shard)
                    'metrics': {
                        'clickhouse_query_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(ClickHouseProfileEvents_Query[5m]))',
                            'title': 'Queries [queries/s]'
                        },
                        'clickhouse_running_queries': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(ClickHouseMetrics_Query)',
                            'title': 'Running Queries [count]'
                        },
                        'clickhouse_failed_queries': {
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            'query': 'sum(ClickHouseProfileEvents_FailedQuery)',
                            'title': 'Failed Queries [count]'
                        },
                        'clickhouse_selected_rows_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(ClickHouseProfileEvents_SelectedRows[5m]))',
                            'title': 'Rows Read [rows/s]'
                        },
                        'clickhouse_selected_bytes_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(ClickHouseProfileEvents_SelectedBytes[5m]))/1024/1024',
                            'title': 'Data Read, uncompressed [MiB/s]'
                        },
                        'clickhouse_inserted_rows_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(ClickHouseProfileEvents_InsertedRows[5m]))',
                            'title': 'Rows Inserted [rows/s]'
                        },
                        'clickhouse_memory_tracked': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(ClickHouseMetrics_MemoryTracking)/1024/1024',
                            'title': 'Memory Tracked by ClickHouse [MiB]'
                        },
                        'clickhouse_running_merges': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(ClickHouseMetrics_Merge)',
                            'title': 'Running Merges [count]'
                        },
                        'clickhouse_parts': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(ClickHouseAsyncMetrics_TotalPartsOfMergeTreeTables)',
                            'title': 'Parts of MergeTree Tables [count]'
                        },
                    },
                },
                'mysql': {
                    'metrics': {
                        'mysql_buffer_pool_hit_ratio': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': '1 - (sum(rate(mysql_global_status_innodb_buffer_pool_reads[5m])) / sum(rate(mysql_global_status_innodb_buffer_pool_read_requests[5m])))',
                            'title': 'InnoDB Buffer Pool Hit Ratio [0..1]'
                        },
                        'mysql_queries_per_second': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'rate(mysql_global_status_queries[5m])',
                            'title': 'Queries Per Second [queries/s]'
                        },
                        'mysql_connections_usage': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'mysql_global_status_threads_connected / mysql_global_variables_max_connections',
                            'title': 'Connection Usage Ratio [0..1]'
                        },
                        'mysql_slow_queries': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'rate(mysql_global_status_slow_queries[5m])',
                            'title': 'Slow Queries Rate [queries/s]'
                        },
                        'mysql_innodb_log_waits': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'rate(mysql_global_status_innodb_log_waits[5m])',
                            'title': 'InnoDB Log Waits Rate [waits/s]'
                        },
                        'innodb_log_fsyncs_per_second': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(mysql_global_status_innodb_os_log_fsyncs[5m]))',
                            'title': 'InnoDB Redo Log fsyncs [fsyncs/s]'
                        },
                        'innodb_avg_bytes_per_fsync': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(mysql_global_status_innodb_os_log_written[1m])) / sum(rate(mysql_global_status_innodb_os_log_fsyncs[1m]))',
                            'title': 'Average Redo Log Bytes per fsync [B]'
                        },
                        'innodb_buffer_pool_wait_free': {
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            # cumulative counter of waits for a clean page
                            'query': 'sum(mysql_global_status_innodb_buffer_pool_wait_free)',
                            'title': 'InnoDB Buffer Pool Wait Free [count]'
                        },
                        'innodb_max_dirty_pages_pct': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(mysql_global_variables_innodb_max_dirty_pages_pct)',
                            'title': 'InnoDB Max Dirty Pages [%]'
                        },
                        'innodb_max_dirty_pages_pct_lwm': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(mysql_global_variables_innodb_max_dirty_pages_pct_lwm)',
                            'title': 'InnoDB Max Dirty Pages Low Watermark [%]'
                        },
                        'innodb_buffer_pool_bytes_dirty': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(avg_over_time(mysql_global_status_innodb_buffer_pool_bytes_dirty[5m]))',
                            'title': 'InnoDB Buffer Pool Dirty Bytes [B]'
                        },
                        'innodb_buffer_pool_dirty_pages': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(avg_over_time(mysql_global_status_buffer_pool_dirty_pages[5m]))',
                            'title': 'InnoDB Buffer Pool Dirty Pages [pages]'
                        },
                        'innodb_buffer_pool_pages_flushed': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(mysql_global_status_buffer_pool_page_changes_total{{operation="flushed"}}[5m]))',
                            'title': 'InnoDB Buffer Pool Pages Flushed [pages/s]'
                        },
                        'innodb_buffer_pool_bytes_data': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(mysql_global_status_innodb_buffer_pool_bytes_data)',
                            'title': 'InnoDB Buffer Pool Bytes Data [B]'
                        },
                        'innodb_redo_log_flushed_to_disk_lsn': {
                            'type': 'application',
                            'active': True,
                            'metric': 'counter',
                            # LSN is a byte position that only grows, so its change over a phase is the redo flushed
                            'query': 'sum(mysql_global_status_innodb_redo_log_flushed_to_disk_lsn)',
                            'title': 'InnoDB Redo Log Flushed to Disk [B]'
                        },
                        # --- Derived Metrics ---
                        'innodb_dirty_pages_ratio': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            # bytes_data already includes the dirty pages
                            'query': 'sum(mysql_global_status_innodb_buffer_pool_bytes_dirty) / sum(mysql_global_status_innodb_buffer_pool_bytes_data) * 100',
                            'title': 'Ratio of Dirty Pages in Buffer Pool [%]'
                        },
                        'innodb_log_fsyncs_per_dirty_page': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(rate(mysql_global_status_innodb_os_log_fsyncs[5m])) / sum(avg_over_time(mysql_global_status_buffer_pool_dirty_pages[5m]))',
                            'title': 'Redo Log fsyncs per Dirty Page'
                        },
                        'mysql_threads_running': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(mysql_global_status_threads_running)',
                            'title': 'Threads Running'
                        },
                        'mysql_handler_rollback_rate': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'rate(mysql_global_status_handlers_total{{handler="rollback"}}[5m])',
                            'title': 'Rollback Operations Rate [ops/s]'
                        },
                        'mysql_table_locks_waited': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'rate(mysql_global_status_table_locks_waited[5m])',
                            'title': 'Table Lock Waits Rate [waits/s]'
                        },
                        'mysql_tmp_disk_tables': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'rate(mysql_global_status_created_tmp_disk_tables[5m])',
                            'title': 'Temporary Disk Tables Rate [tables/s]'
                        },
                        'mysql_open_files_ratio': {
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(mysql_global_status_open_files) / sum(mysql_global_variables_open_files_limit)',
                            'title': 'Open Files Usage Ratio [0..1]'
                        }
                    },
                },
                'postgresql': {
                    'metrics': {
                        'pg_stat_activity_count_idle': { # not clear
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(pg_stat_activity_count{{datname!~"template.*", state="idle"}})',
                            'query2': 'sum(pg_stat_activity_count{{datname!~"template.*", state="idle", datname="{database}"}})',
                            'title': 'Number of Idle Sessions [sessions]',
                        },
                        'pg_stat_activity_count_idle_transaction': { # not clear
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
                            'query': 'sum(pg_stat_activity_count{{datname!~"template.*", state="idle in transaction"}})',
                            'query2': 'sum(pg_stat_activity_count{{datname!~"template.*", state="idle in transaction", datname="{database}"}})',
                            'title': 'Number of Idle-in-transaction Sessions [sessions]',
                        },
                        'pg_stat_activity_count_idle_transaction_aborted': { # not clear
                            'type': 'application',
                            'active': True,
                            'metric': 'gauge',
