                    'loading_parameters': {'HAMMERDB_TYPE': 'citus', 'BEXHOMA_USER': 'postgres', 'BEXHOMA_PASSWORD': 'password1234', 'BEXHOMA_DATABASE': 'postgres'},                                     # environment of the loading jobs
                    'benchmarking_parameters': {'HAMMERDB_TYPE': 'citus', 'BEXHOMA_USER': 'postgres', 'BEXHOMA_PASSWORD': 'password1234', 'BEXHOMA_DATABASE': 'postgres'},                                # environment of the benchmarking jobs
