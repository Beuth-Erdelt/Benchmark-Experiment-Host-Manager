            'loadData': '/pgclient/psql -h 127.0.0.1 -U postgres -d {database} < {scriptname}',
            'delay_prepare': 0,
            'client_env': {'PGPASSWORD': 'BexhomaBenchmarkPassword2026'},   # psql of the loader images, no trust authentication
            'template': {
                'version': 'v2026-10-22',
                'alias': 'General-D',
                'docker_alias': 'GP-D',
                'dialect': 'CedarDB',   # key of the query variants in the query files
                'JDBC': {
                    'driver': "org.postgresql.Driver",
                    'auth': ["postgres", "BexhomaBenchmarkPassword2026"],   # = CEDAR_PASSWORD of the template; goes through sed in the YCSB and Benchbase images, no special characters
                    'url': 'jdbc:postgresql://{serverip}:9091/{database}?reWriteBatchedInserts=true&currentSchema={schema}',
                    'jar': 'postgresql-42.5.0.jar',
                    'database': 'postgres',
                    'schema': 'public',
                    'explain': ['EXPLAIN (VERBOSE, FORMAT JSON) {query}'],
                }
            },
            'logfile': '/usr/local/data/logfile',
            'datadir': '/var/lib/cedardb/data/',
            'priceperhourdollar': 0.0,
        },
        'PGBouncer': {
            'base_system': 'PostgreSQL',   # folder of the benchmark's scripts when it is not this DBMS's own
            'storage_prefix': 'postgresql',   # name of the storage (volume) of this DBMS, the same for every benchmark
            'sut_attributes': {'sut_has_pool': True},   # how the SUT is set up, see bexhoma/system_descriptors.py
            'benchmarks': {   # one key per benchmark the DBMS can run (missing = not compatible); see bexhoma/system_descriptors.py
                'ycsb': {
                    'default': True,                                                                                                                                                                      # runs when -dbms is not given
                    'reset_scripts': ['reset-ycsb.sql'],                                                                                                                                                  # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                                                                                  # environment of the loading jobs
                    'benchmarking_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                                                                             # environment of the benchmarking jobs
                    'pooling': {'sut_parameters': {'DEFAULT_POOL_SIZE': '{pool_out}', 'MIN_POOL_SIZE': '{pool_out}', 'MAX_CLIENT_CONN': '{pool_in}'}, 'resources': {'replicas_pooling': '{pool_pods}'}},  # one configuration per combination of -xnpp, -xnpi and -xnpo
                },
                'benchbase': {
                    'default': True,                                                                                                                                                                      # runs when -dbms is not given
                    'reset_scripts': ['reset-benchbase.sql'],                                                                                                                                             # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'BENCHBASE_PROFILE': 'postgres', 'BEXHOMA_DATABASE': 'postgres', 'BENCHBASE_NEWCONNPERTXN': '{newconn}'},                                                      # environment of the loading jobs
                    'benchmarking_parameters': {'BENCHBASE_PROFILE': 'postgres', 'BEXHOMA_DATABASE': 'postgres', 'BENCHBASE_NEWCONNPERTXN': '{newconn}'},                                                 # environment of the benchmarking jobs
                    'pooling': {'sut_parameters': {'DEFAULT_POOL_SIZE': '{pool_out}', 'MIN_POOL_SIZE': '{pool_out}', 'MAX_CLIENT_CONN': '{pool_in}'}, 'resources': {'replicas_pooling': '{pool_pods}'}},  # one configuration per combination of -xnpp, -xnpi and -xnpo
                },
            },
            'loadData': 'psql -U postgres -d {database} < {scriptname}',
            'delay_prepare': 0,
            'template': {
                'version': 'v11.4',
                'alias': 'General-E',
                'docker_alias': 'GP-E',
                 'JDBC': {
                    'driver': "org.postgresql.Driver",
                    'auth': ["postgres", ""],
                    'url': 'jdbc:postgresql://{serverip}:9091/{database}?reWriteBatchedInserts=true',
                    'jar': 'postgresql-42.5.0.jar',
                    'database': 'postgres',
                    'schema': 'public',
                    'explain': ['EXPLAIN (VERBOSE, FORMAT JSON) {query}'],
                }
            },
            'logfile': '/usr/local/data/logfile',
            'datadir': '/var/lib/postgresql/data/',
            'priceperhourdollar': 0.0,
            'monitor': {
                'sut': {
                    'metrics': 'postgresql',
                    #'blackbox': True,
                    'discovery': True,
                    'headless': True,
                    'discovery_config': """
  - job_name: 'postgresql-pods'
    scrape_interval: {prometheus_interval}
    scrape_timeout: {prometheus_interval}
    metrics_path: /metrics
    kubernetes_sd_configs:
      - role: pod
        namespaces:
          names: ["{namespace}"]
    relabel_configs:
      # Only select pods by labels
      - source_labels: [__meta_kubernetes_pod_label_app,
                        __meta_kubernetes_pod_label_component,
                        __meta_kubernetes_pod_label_dbms]
        regex: bexhoma;sut;PGBouncer
        action: keep
      # Map pod IP -> address:port
      - source_labels: [__meta_kubernetes_pod_ip]
        target_label: __address__
        replacement: '$1:9187'
        action: replace
      # Optional: rename instance label to pod name
      - source_labels: [__meta_kubernetes_pod_name]
        target_label: instance
      # Optional: drop pods that are not running
      - source_labels: [__meta_kubernetes_pod_phase]
        regex: Running
        action: keep""",
                },
                'pool': {
                    'metrics': 'pgbouncer',
                    'discovery': True,
                    'headless': True,
                    'discovery_config': """
  - job_name: 'pgbouncer-pods'
    scrape_interval: {prometheus_interval}
    scrape_timeout: {prometheus_interval}
    metrics_path: /metrics
    kubernetes_sd_configs:
      - role: pod
        namespaces:
          names: ["{namespace}"]
    relabel_configs:
      # Only select pods by labels
      - source_labels: [__meta_kubernetes_pod_label_app,
                        __meta_kubernetes_pod_label_component,
                        __meta_kubernetes_pod_label_dbms]
        regex: bexhoma;pool;PGBouncer
        action: keep
      # Map pod IP -> address:port
      - source_labels: [__meta_kubernetes_pod_ip]
        target_label: __address__
        replacement: '$1:9127'
        action: replace
      # Optional: rename instance label to pod name
      - source_labels: [__meta_kubernetes_pod_name]
        target_label: instance
      # Optional: drop pods that are not running
      - source_labels: [__meta_kubernetes_pod_phase]
        regex: Running
        action: keep""",
                }
            }
        },
        'MySQL': {
            'storage_prefix': 'mysql',   # name of the storage (volume) of this DBMS, the same for every benchmark
            'benchmarks': {   # one key per benchmark the DBMS can run (missing = not compatible); see bexhoma/system_descriptors.py
                'tpch': {
                    'experiment_yaml': True,                                                                                                                                                                                     # may be named in an experiment.yaml
                    'refresh_template': 'jobtemplate-benchmarking-tpch-refresh-MySQL.yml',                                                                                                                                       # job template in k8s/ of the TPC-H refresh stream (-xrs)
                    'default': True,                                                                                                                                                                                             # runs when -dbms is not given
                    'loading_template': 'jobtemplate-loading-tpch-MySQL.yml',                                                                                                                                                    # job template in k8s/ that loads the data
                    'reset_scripts': ['reset-tpch.sql', 'reset-flush.sh'],                                                                                                                                                       # scripts run before each benchmarking round (-ar)
                    'per_loading_threads': {'MYSQL_LOADING_THREADS': '{threads}', 'MYSQL_LOADING_PARALLEL': 1},                                                                                                                  # one configuration per -nlt value, with these loading parameters
                },
                'tpcds': {
                    'default': True,                                                                                                                                                                                             # runs when -dbms is not given
                    'loading_template': 'jobtemplate-loading-tpcds-MySQL.yml',                                                                                                                                                   # job template in k8s/ that loads the data
                    'reset_scripts': ['reset-tpcds.sql', 'reset-flush.sh'],                                                                                                                                                      # scripts run before each benchmarking round (-ar)
                    'per_loading_threads': {'MYSQL_LOADING_THREADS': '{threads}', 'MYSQL_LOADING_PARALLEL': 1},                                                                                                                  # one configuration per -nlt value, with these loading parameters
                },
                'ssb': {
                    'loading_template': 'jobtemplate-loading-ssb-MySQL.yml',                                                                                                                                                     # job template in k8s/ that loads the data
                    'reset_scripts': ['reset-ssb{schema_suffix}.sql', 'reset-flush.sh'],                                                                                                                                         # scripts run before each benchmarking round (-ar)
                },
                'ycsb': {
                    'default': True,                                                                                                                                                                                             # runs when -dbms is not given
                    'reset_scripts': ['reset-ycsb.sql', 'reset-flush.sh'],                                                                                                                                                       # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                                                                                                         # environment of the loading jobs
                    'benchmarking_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                                                                                                    # environment of the benchmarking jobs
                },
                'benchbase': {
                    'default': True,                                                                                                                                                                                             # runs when -dbms is not given
                    'reset_scripts': {'$by': 'benchmark', 'tpcc': ['reset-benchbase.sql', 'reset-flush.sh']},                                                                                                                    # scripts run before each benchmarking round (-ar)
                    'sut_parameters': {'MYSQL_DATABASE': 'benchbase'},                                                                                                                                                           # environment of the SUT container (a value set by the experiment wins)
                    'loading_parameters': {'BENCHBASE_PROFILE': 'mysql', 'BEXHOMA_DATABASE': 'benchbase'},                                                                                                                       # environment of the loading jobs
                    'benchmarking_parameters': {'BENCHBASE_PROFILE': 'mysql', 'BEXHOMA_DATABASE': 'benchbase'},                                                                                                                  # environment of the benchmarking jobs
                    'multi_tenancy': ['container', 'database'],                                                                                                                                                                  # tenancy modes (-mtb) the DBMS supports
                    'tenant_parameters': {'loading': {'BEXHOMA_TENANT_BY': '{tenant_by}', 'BEXHOMA_TENANT_NUM': '{num_tenants}'}, 'benchmarking': {'BEXHOMA_TENANT_BY': '{tenant_by}', 'BEXHOMA_TENANT_NUM': '{num_tenants}'}},  # parameters a multi-tenant run adds to the jobs
                },
                'tpcc': {
                    'default': True,                                                                                                                                                                                             # runs when -dbms is not given
                    'reset_scripts': ['reset-tpcc.sql', 'reset-flush.sh'],                                                                                                                                                       # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'HAMMERDB_TYPE': 'mysql', 'HAMMERDB_MYSQL_ENGINE': 'innodb'},                                                                                                                         # environment of the loading jobs
                    'benchmarking_parameters': {'HAMMERDB_TYPE': 'mysql', 'HAMMERDB_MYSQL_ENGINE': 'innodb'},                                                                                                                    # environment of the benchmarking jobs
                },
            },
            'abbreviation': 'my',   # short name in volume and worker names (get_storage_configuration)
            #'loadData': 'mysql --local-infile < {scriptname}',
            'loadData': 'mysql --local-infile {database} < {scriptname}',
            'delay_prepare': 120,
            'template': {
                'version': 'CE 8.0.36',
                'alias': 'General-C',
                'docker_alias': 'GP-C',
                'dialect': 'MySQL',
                'JDBC': {
                    'driver': "com.mysql.cj.jdbc.Driver",
                    'auth': ["root", "root"],
                    'url': 'jdbc:mysql://{serverip}:9091/{dbname}?rewriteBatchedStatements=true',
                    'jar': ['mysql-connector-j-8.0.31.jar', 'slf4j-simple-1.7.21.jar'],
                    'database': 'mysql', # does not exist, must be overwritten
                    'explain': ['EXPLAIN FORMAT=JSON {query}'],
                }
            },
            'logfile': '/var/log/mysqld.log',
            'datadir': '/var/lib/mysql/',
            'priceperhourdollar': 0.0,
            # MySQL 9: caching_sha2_password needs TLS for the first login; bexhoma creates
            # a CA + server certificate Secret per SUT (bexhoma/tls.py) for server and HammerDB
            'tls': {'secret': True},
            'monitor': {
                'sut': {
                    'metrics': 'mysql',
                    'blackbox': False,
                },
            },
        },
