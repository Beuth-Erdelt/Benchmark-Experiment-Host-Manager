    scrape_interval: {prometheus_interval}
    scrape_timeout: {prometheus_interval}
    metrics_path: /metrics
    kubernetes_sd_configs:
      - role: pod
        namespaces:
          names: ["{namespace}"]
    relabel_configs:
      # Only select pods by labels
      - source_labels: [__meta_kubernetes_pod_label_app,
                        __meta_kubernetes_pod_label_component,
                        __meta_kubernetes_pod_label_dbms]
        regex: bexhoma;pd;TiDB
        action: keep
      # Map pod IP -> address:port
      - source_labels: [__meta_kubernetes_pod_ip]
        target_label: __address__
        replacement: '$1:2379'
        action: replace
      # Optional: rename instance label to pod name
      - source_labels: [__meta_kubernetes_pod_name]
        target_label: instance
      # Optional: drop pods that are not running
      - source_labels: [__meta_kubernetes_pod_phase]
        regex: Running
        action: keep""",
                },
                'tikv': {
                    'metrics': 'tikv',
                    'discovery': True,
                    'headless': True,
                    'discovery_config': """
  - job_name: 'tidb-pods-tikv'
    scrape_interval: {prometheus_interval}
    scrape_timeout: {prometheus_interval}
    metrics_path: /metrics
    kubernetes_sd_configs:
      - role: pod
        namespaces:
          names: ["{namespace}"]
    relabel_configs:
      # Only select pods by labels
      - source_labels: [__meta_kubernetes_pod_label_app,
                        __meta_kubernetes_pod_label_component,
                        __meta_kubernetes_pod_label_dbms]
        regex: bexhoma;tikv;TiDB
        action: keep
      # Map pod IP -> address:port
      - source_labels: [__meta_kubernetes_pod_ip]
        target_label: __address__
        replacement: '$1:20180'
        action: replace
      # Optional: rename instance label to pod name
      - source_labels: [__meta_kubernetes_pod_name]
        target_label: instance
      # Optional: drop pods that are not running
      - source_labels: [__meta_kubernetes_pod_phase]
        regex: Running
        action: keep""",
                },
            },
        },
        'SQLServer': {
            # SQL Server 2022 Developer edition: no publication of benchmark results without Microsoft's
            # prior written approval (license, section "Benchmark testing"); internal tests only (#834)
            'storage_prefix': 'sqlserver',   # name of the storage (volume) of this DBMS, the same for every benchmark
            'benchmarks': {   # one key per benchmark the DBMS can run (missing = not compatible); see bexhoma/system_descriptors.py
                'tpch': {
                    'refresh_template': 'jobtemplate-benchmarking-tpch-refresh-SQLServer.yml',                                                            # job template in k8s/ of the TPC-H refresh stream (-xrs)
                    'loading_template': 'jobtemplate-loading-tpch-SQLServer.yml',                                                                       # job template in k8s/ that loads the data
                    'reset_scripts': ['reset-tpch.sql'],                                                                                                 # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'BEXHOMA_DATABASE': 'tpch'},                                                                                  # environment of the loading jobs; also the database of loadData
                },
                'ycsb': {
                    'reset_scripts': ['reset-ycsb.sql'],                                                                                                 # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc', 'BEXHOMA_DATABASE': 'ycsb', 'BEXHOMA_JAR': 'mssql-jdbc-9.4.1.jre8.jar'},  # environment of the loading jobs; also the database of loadData; YCSB keeps only the URL before ';': driver 9.4.1 does not encrypt by default
                    'benchmarking_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc', 'BEXHOMA_DATABASE': 'ycsb', 'BEXHOMA_JAR': 'mssql-jdbc-9.4.1.jre8.jar'},  # environment of the benchmarking jobs
                },
                'benchbase': {
                    'reset_scripts': {'$by': 'benchmark', 'tpcc': ['reset-benchbase.sql']},                                                             # scripts run before each benchmarking round (-ar); only TPC-C has a config for SQL Server
                    'loading_parameters': {'BENCHBASE_PROFILE': 'sqlserver', 'BEXHOMA_DATABASE': 'benchbase'},                                           # environment of the loading jobs; also the database of loadData
                    'benchmarking_parameters': {'BENCHBASE_PROFILE': 'sqlserver', 'BEXHOMA_DATABASE': 'benchbase'},                                      # environment of the benchmarking jobs
                },
                'tpcc': {
                    'reset_scripts': ['reset-tpcc.sql'],                                                                                                 # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'HAMMERDB_TYPE': 'mssqlserver', 'BEXHOMA_DATABASE': 'tpcc'},                                                 # environment of the loading jobs; also the database of loadData
                    'benchmarking_parameters': {'HAMMERDB_TYPE': 'mssqlserver', 'BEXHOMA_DATABASE': 'tpcc'},                                            # environment of the benchmarking jobs
                },
            },
            'abbreviation': 'mss',   # short name in volume and worker names (get_storage_configuration)
            # sqlcmd of mssql-tools18 in the image; password from SQLCMDPASSWORD of the template (no $ on the command line);
            # /tmp/bexhoma-database.sql (written by the template) creates the database {database} and switches to it;
            # -b exits 1 on an error, -r0 writes errors (severity 11+) to stderr, -C trusts the self-signed certificate, -I quoted identifiers
            'loadData': '/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -C -b -r0 -I -v database={database} -i /tmp/bexhoma-database.sql,{scriptname}',
            'delay_prepare': 30,
            'template': {
                'version': '2022-CU27',
                'alias': 'General-G',
                'docker_alias': 'GP-G',
                'dialect': 'TSQL',   # key of the query variants in the query files
                'JDBC': {
                    'driver': "com.microsoft.sqlserver.jdbc.SQLServerDriver",
                    'auth': ["sa", "BexhomaBenchmarkPassword2026"],   # = MSSQL_SA_PASSWORD of the template; goes through sed in the YCSB and Benchbase images, no special characters
                    'url': 'jdbc:sqlserver://{serverip}:9091;databaseName={dbname};encrypt=false;trustServerCertificate=true',
                    'jar': 'mssql-jdbc-12.8.1.jre8.jar',
                    'database': 'master',   # the database of each benchmark is BEXHOMA_DATABASE of its loading_parameters
                }
            },
            'logfile': '/var/opt/mssql/log/errorlog',
            'datadir': '/var/opt/mssql/data/',
            'priceperhourdollar': 0.0,
        },
        'OracleDB': {
            # Oracle AI Database 26ai Free (23.26.3), Oracle Free Use Terms; at most 2 CPU threads, 2 GB memory and
            # 12 GB user data. Results are kept internal (#828), see docs/DBMS.md
            'storage_prefix': 'oracledb',   # name of the storage (volume) of this DBMS, the same for every benchmark
            'benchmarks': {   # one key per benchmark the DBMS can run (missing = not compatible); see bexhoma/system_descriptors.py
                'tpch': {
                    'refresh_template': 'jobtemplate-benchmarking-tpch-refresh-OracleDB.yml',                                                             # job template in k8s/ of the TPC-H refresh stream (-xrs)
                    'loading_template': 'jobtemplate-loading-tpch-OracleDB.yml',                                                                         # job template in k8s/ that loads the data
                    'reset_scripts': ['reset-tpch.sql'],                                                                                                 # scripts run before each benchmarking round (-ar)
                },
                'ycsb': {
                    'reset_scripts': ['reset-ycsb.sql'],                                                                                                 # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                                 # environment of the loading jobs
                    'benchmarking_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                            # environment of the benchmarking jobs
                },
                'benchbase': {
                    'reset_scripts': {'$by': 'benchmark', 'tpcc': ['reset-benchbase.sql']},                                                             # scripts run before each benchmarking round (-ar); only TPC-C has a config for Oracle
                    'loading_parameters': {'BENCHBASE_PROFILE': 'oracle'},                                                                               # environment of the loading jobs
                    'benchmarking_parameters': {'BENCHBASE_PROFILE': 'oracle'},                                                                          # environment of the benchmarking jobs
                },
                'tpcc': {
                    'reset_scripts': ['reset-tpcc.sql'],                                                                                                 # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'HAMMERDB_TYPE': 'oracle', 'BEXHOMA_DATABASE': 'tpcc'},                                                      # environment of the loading jobs; HammerDB creates the user (schema) tpcc, also the schema of loadData
                    'benchmarking_parameters': {'HAMMERDB_TYPE': 'oracle', 'BEXHOMA_DATABASE': 'tpcc'},                                                 # environment of the benchmarking jobs
                },
            },
            'abbreviation': 'ora',   # short name in volume and worker names (get_storage_configuration)
            # sqlplus of the image as SYSDBA (no password); /tmp/bexhoma-session.sql (written by the template) stops at the
            # first error with exit code 1, switches to FREEPDB1 and to the schema {database} (if the user exists), then runs the script
            'loadData': 'sqlplus -S -L / as sysdba @/tmp/bexhoma-session.sql {database} {scriptname}',
            'delay_prepare': 0,
            'template': {
                'version': '23.26.3 Free',
                'alias': 'General-H',
                'docker_alias': 'GP-H',
                'dialect': 'Oracle',   # key of the query variants in the query files
                'JDBC': {
                    'driver': "oracle.jdbc.OracleDriver",
                    'auth': ["bexhoma", "BexhomaBenchmark2026"],   # user created by the template, password = ORACLE_PWD; goes through sed in the YCSB and Benchbase images, no special characters
                    'url': 'jdbc:oracle:thin:@//{serverip}:9091/FREEPDB1',
                    'jar': 'ojdbc8-23.26.3.0.0.jar',
                    'database': 'bexhoma',   # schema (= user) of the scripts; HammerDB uses its own user tpcc (BEXHOMA_DATABASE of its parameters)
                }
            },
            'logfile': '/opt/oracle/diag/rdbms/free/FREE/trace/alert_FREE.log',
            'datadir': '/opt/oracle/oradata/',
            'priceperhourdollar': 0.0,
        },
        'DB2': {
            # IBM Db2 Community Edition 12.1.5 (container format); at most 4 cores and 8 GB of instance memory
            # (license). The AI optimizer (Technology Preview Code) is switched off by the template. Results are
            # kept internal (#829), see docs/DBMS.md
            'storage_prefix': 'db2',   # name of the storage (volume) of this DBMS, the same for every benchmark
            'benchmarks': {   # one key per benchmark the DBMS can run (missing = not compatible); see bexhoma/system_descriptors.py
                'tpch': {
                    'refresh_template': 'jobtemplate-benchmarking-tpch-refresh-DB2.yml',                                                      # job template in k8s/ of the TPC-H refresh stream (-xrs)
                    'loading_template': 'jobtemplate-loading-tpch-DB2.yml',                                                                   # job template in k8s/ that loads the data
                    'reset_scripts': ['reset-tpch.sql'],                                                                                      # scripts run before each benchmarking round (-ar)
                    'benchmarking_parameters': {'BEXHOMA_JAR_URL': 'https://repo1.maven.org/maven2/com/ibm/db2/jcc/12.1.5.0/jcc-12.1.5.0.jar', 'BEXHOMA_JAR_SHA256': '04150111a29370247d162c3f05b8e938bf1314f19a63ad9a5302d88dd478e8e8'},  # environment of the benchmarking jobs: the JDBC driver is downloaded at the start, not part of the image
                },
                'tpcds': {
                    'loading_template': 'jobtemplate-loading-tpcds-DB2.yml',                                                                  # job template in k8s/ that loads the data
                    'reset_scripts': ['reset-tpcds.sql'],                                                                                     # scripts run before each benchmarking round (-ar)
                    'benchmarking_parameters': {'BEXHOMA_JAR_URL': 'https://repo1.maven.org/maven2/com/ibm/db2/jcc/12.1.5.0/jcc-12.1.5.0.jar', 'BEXHOMA_JAR_SHA256': '04150111a29370247d162c3f05b8e938bf1314f19a63ad9a5302d88dd478e8e8'},  # environment of the benchmarking jobs: the JDBC driver is downloaded at the start, not part of the image
                },
                'ycsb': {
                    'reset_scripts': ['reset-ycsb.sql'],                                                                                      # scripts run before each benchmarking round (-ar)
                    'loading_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc', 'BEXHOMA_JAR_URL': 'https://repo1.maven.org/maven2/com/ibm/db2/jcc/12.1.5.0/jcc-12.1.5.0.jar', 'BEXHOMA_JAR_SHA256': '04150111a29370247d162c3f05b8e938bf1314f19a63ad9a5302d88dd478e8e8'},  # environment of the loading jobs: the JDBC driver is downloaded at the start
                    'benchmarking_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc', 'BEXHOMA_JAR_URL': 'https://repo1.maven.org/maven2/com/ibm/db2/jcc/12.1.5.0/jcc-12.1.5.0.jar', 'BEXHOMA_JAR_SHA256': '04150111a29370247d162c3f05b8e938bf1314f19a63ad9a5302d88dd478e8e8'},  # environment of the benchmarking jobs
                },
                'benchbase': {
                    'reset_scripts': {'$by': 'benchmark', 'tpcc': ['reset-benchbase.sql']},                                                   # scripts run before each benchmarking round (-ar); only TPC-C has a config for Db2
                    'loading_parameters': {'BENCHBASE_PROFILE': 'db2', 'BEXHOMA_JAR_URL': 'https://repo1.maven.org/maven2/com/ibm/db2/jcc/12.1.5.0/jcc-12.1.5.0.jar', 'BEXHOMA_JAR_SHA256': '04150111a29370247d162c3f05b8e938bf1314f19a63ad9a5302d88dd478e8e8'},  # environment of the loading jobs: profile db2 of the bexhoma image, driver downloaded at the start
                    'benchmarking_parameters': {'BENCHBASE_PROFILE': 'db2', 'BEXHOMA_JAR_URL': 'https://repo1.maven.org/maven2/com/ibm/db2/jcc/12.1.5.0/jcc-12.1.5.0.jar', 'BEXHOMA_JAR_SHA256': '04150111a29370247d162c3f05b8e938bf1314f19a63ad9a5302d88dd478e8e8'},  # environment of the benchmarking jobs
                },
            },
            'abbreviation': 'db2',   # short name in volume and worker names (get_storage_configuration)
            # /tmp/bexhoma-run.sh (written by the template): one CLP session of db2inst1 connects to the database {database}
            # and runs the script with db2 -tvsf (stops at the first error); an error ends it with exit code 1 and ERROR on stderr
            'loadData': 'bash /tmp/bexhoma-run.sh {database} {scriptname}',
            'delay_prepare': 0,
            'template': {
                'version': '12.1.5 Community',
                'alias': 'General-I',
                'docker_alias': 'GP-I',
                'dialect': 'DB2',   # key of the query variants in the query files
                'JDBC': {
                    'driver': "com.ibm.db2.jcc.DB2Driver",
                    'auth': ["db2inst1", "BexhomaBenchmark2026"],   # instance owner, password = DB2INST1_PASSWORD of the template; goes through sed in the YCSB image, no special characters
                    'url': 'jdbc:db2://{serverip}:9091/{database}',
                    'jar': 'jcc-12.1.5.0.jar',
                    'database': 'bexhoma',   # database created by the template; the tables are in the default schema DB2INST1 of the user
                }
            },
            'logfile': '/database/config/db2inst1/sqllib/db2dump/DIAG0000/db2diag.log',
            'datadir': '/database/data/',
            'priceperhourdollar': 0.0,
        },
        'DatabaseService': {
            'storage_prefix': 'dbs',   # name of the storage (volume) of this DBMS, the same for every benchmark
            'sut_attributes': {'sut_role': 'placeholder', 'monitoring_sut': False, 'resource_sweep': False},   # how the SUT is set up, see bexhoma/system_descriptors.py
            'benchmarks': {   # one key per benchmark the DBMS can run (missing = not compatible); see bexhoma/system_descriptors.py
                'tpch': {
                    'refresh_template': 'jobtemplate-benchmarking-tpch-refresh-PostgreSQL.yml',                                                       # job template in k8s/ of the TPC-H refresh stream (-xrs)
                    'loading_template': 'jobtemplate-loading-tpch-PostgreSQL.yml',                                                                    # job template in k8s/ that loads the data
                    'loading_parameters': {'BEXHOMA_HOST': 'bexhoma-service'},                                                                        # environment of the loading jobs
                },
                'ycsb': {
                    'loading_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                              # environment of the loading jobs
                    'benchmarking_parameters': {'BEXHOMA_DBMS_TYPE': 'jdbc'},                                                                         # environment of the benchmarking jobs
                },
                'benchbase': {
                    'loading_parameters': {'BENCHBASE_PROFILE': 'postgres', 'BEXHOMA_DATABASE': 'postgres', 'BEXHOMA_HOST': 'bexhoma-service'},       # environment of the loading jobs
                    'benchmarking_parameters': {'BENCHBASE_PROFILE': 'postgres', 'BEXHOMA_DATABASE': 'postgres', 'BEXHOMA_HOST': 'bexhoma-service'},  # environment of the benchmarking jobs
                },
            },
            'loadData': 'psql -U postgres --host bexhoma-service.{namespace}.svc.cluster.local --port 9091 < {scriptname}',
            #'delay_prepare': 600,
            'template': {
                'version': 'v11.4',
                'alias': 'Service-A',
                'docker_alias': 'SVC-A',
                'dialect': 'PostgreSQL',   # key of the query variants in the query files
                 'JDBC': {
                    'driver': "org.postgresql.Driver",
                    'auth': ["postgres", ""],
                    'url': 'jdbc:postgresql://bexhoma-service.{namespace}.svc.cluster.local:9091/postgres?reWriteBatchedInserts=true',
                    'jar': 'postgresql-42.5.0.jar',
                    'database': 'postgres',
                    'schema': 'public',
                    'explain': ['EXPLAIN (VERBOSE, FORMAT JSON) {query}'],
                }
            },
            'logfile': '/usr/local/data/logfile',
            'datadir': '/var/lib/postgresql/data/',
            'priceperhourdollar': 0.0,
        },
        'Hardware': {
            'abbreviation': 'hw',   # short name in volume and worker names (get_storage_configuration)
            'loadData': '',
            'delay_prepare': 0,
            'template': {
                'version': 'v1.0',
                'alias': 'Hardware',
                'docker_alias': 'HW',
                # required by manifest.py's non-JDBC branch (BEXHOMA_USER/BEXHOMA_PASSWORD
                # env injection); not used by the benchmarker scripts themselves, which
                # authenticate over SSH via BEXHOMA_SUT_USER/BEXHOMA_SUT_KEY instead.
                'auth': ['bench', ''],
            },
            'logfile': '',
            'datadir': '/database',
            'priceperhourdollar': 0.0,
        },
    },
}
