# Benchmark-Experiment-Host-Manager | experiments/benchbase/tpcc/Citus
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps), num_worker_shards also by -nws.
{
    'num_worker_shards': {
        'default': 32,
        'type': 'int',
        'description': 'citus.shard_count of the tables distributed by warehouse (Citus default 32)',
    },
    'tpcc_item': {
        'default': 'reference',
        'values': ['reference', 'distributed'],
        'sql': {'reference': "SELECT create_reference_table('item');",
                'distributed': "SELECT create_distributed_table('item', 'i_id');"},
        'description': 'placement of the read-only item table: a copy on every worker, or spread by i_id, '
                       'so that New-Order reads items remotely',
    },
}
