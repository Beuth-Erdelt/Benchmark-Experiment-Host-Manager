# Benchmark-Experiment-Host-Manager | experiments/tpch/PostgreSQL
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps). Also used by PgDuckDB.
{
    'index_method': {
        'default': 'btree',
        'values': ['btree', 'hash', 'brin'],
        'sql': {'btree': '', 'hash': ' USING hash', 'brin': ' USING brin'},
        'description': 'access method of the foreign key indexes (-xii) except the multicolumn index on '
                       'lineitem, which stays a B-tree: hash indexes answer equality only, brin indexes are '
                       'tiny but need physically ordered keys',
    },
    'btree_dedup': {
        'default': 'on',
        'values': ['on', 'off'],
        'sql': {'on': '', 'off': ' WITH (deduplicate_items = off)'},
        'requires': {'index_method': ['btree']},
        'description': 'deduplication of B-tree index entries (-xii; PostgreSQL default on): shrinks '
                       'non-unique foreign key indexes',
    },
    'statistics_target': {
        'default': 100,
        'type': 'int',
        'description': 'default_statistics_target of the database (-xis; PostgreSQL default 100): rows '
                       'sampled and histogram size per column; plan quality vs. ANALYZE time',
    },
    'extended_statistics': {
        'default': 'off',
        'values': ['off', 'on'],
        'sql': {
            'off': '',
            'on': 'CREATE STATISTICS lineitem_dates (dependencies, ndistinct) '
                  'ON l_shipdate, l_commitdate, l_receiptdate FROM lineitem;\n'
                  'CREATE STATISTICS lineitem_flags (dependencies, ndistinct) '
                  'ON l_returnflag, l_linestatus FROM lineitem;\n'
                  'CREATE STATISTICS part_attributes (dependencies, ndistinct) '
                  'ON p_brand, p_type, p_container FROM part;',
        },
        'description': 'multi-column statistics (-xis) on correlated columns of lineitem and part: '
                       'the planner otherwise multiplies their selectivities',
    },
}
