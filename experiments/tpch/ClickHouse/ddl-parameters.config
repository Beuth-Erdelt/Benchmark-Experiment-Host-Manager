# Benchmark-Experiment-Host-Manager | experiments/tpch/ClickHouse
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps).
{
    'order_orders': {
        'default': 'key',
        'values': ['key', 'date'],
        'sql': {'key': 'o_orderkey', 'date': '(o_orderdate, o_orderkey)'},
        'description': 'sort key (= primary index) of orders: by key, or by date first so date ranges '
                       '(Q3-Q5, Q7-Q10, Q12) skip granules',
    },
    'order_lineitem': {
        'default': 'key',
        'values': ['key', 'date'],
        'sql': {'key': '(l_orderkey, l_linenumber)', 'date': '(l_shipdate, l_orderkey, l_linenumber)'},
        'description': 'sort key (= primary index) of lineitem: by key, or by ship date first so date '
                       'ranges (Q1, Q6, Q7, Q14, Q15, Q20) skip granules',
    },
    'partition_orders': {
        'default': 'none',
        'values': ['none', 'year', 'month'],
        'sql': {'none': '', 'year': ' PARTITION BY toYear(o_orderdate)', 'month': ' PARTITION BY toYYYYMM(o_orderdate)'},
        'description': 'partitions of orders by order date: queries with a date range skip whole '
                       'partitions; more partitions mean more parts per insert block',
    },
    'partition_lineitem': {
        'default': 'none',
        'values': ['none', 'year', 'month'],
        'sql': {'none': '', 'year': ' PARTITION BY toYear(l_shipdate)', 'month': ' PARTITION BY toYYYYMM(l_shipdate)'},
        'description': 'partitions of lineitem by ship date: queries with a ship date range (Q1, Q6, Q14, '
                       'Q15, Q20) skip whole partitions; more partitions mean more parts per insert block',
    },
    'index_granularity': {
        'default': 8192,
        'type': 'int',
        'description': 'rows per granule (= entry of the sparse primary index) of orders and lineitem '
                       '(ClickHouse default 8192): smaller granules skip more precisely, the index grows',
    },
    'wide_parts': {
        'default': 'default',
        'values': ['default', 'wide', 'compact'],
        'sql': {'default': '10485760', 'wide': '0', 'compact': '1099511627776'},
        'description': 'part format of orders and lineitem by min_bytes_for_wide_part: default (10 MiB: '
                       'small parts compact, one file; larger parts wide, a file per column), wide (every '
                       'part), compact (every part up to 1 TiB); parallel loaders write many small parts',
    },
    'low_cardinality': {
        'default': 'off',
        'values': ['off', 'on'],
        'sql': {'off': 'String', 'on': 'LowCardinality(String)'},
        'description': 'dictionary encoding of the string columns with few distinct values (flags, modes, '
                       'priorities, segments, brands, types, containers, nation and region names): '
                       'faster filters and GROUP BY',
    },
    'codec': {
        'default': 'default',
        'values': ['default', 'zstd1', 'zstd3'],
        'sql': {'default': '', 'zstd1': ' CODEC(ZSTD(1))', 'zstd3': ' CODEC(ZSTD(3))'},
        'description': 'compression of all columns of orders and lineitem (default: the server setting, '
                       'LZ4): bytes read vs. CPU per scan',
    },
}
