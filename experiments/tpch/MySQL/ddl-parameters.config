# Benchmark-Experiment-Host-Manager | experiments/tpch/MySQL
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps).
{
    'histograms': {
        'default': 'off',
        'values': ['off', 'on'],
        'sql': {
            'off': '',
            'on': 'ANALYZE TABLE tpch.customer UPDATE HISTOGRAM ON c_name, c_address, c_nationkey, c_phone, '
                  'c_acctbal, c_mktsegment WITH 100 BUCKETS;\n'
                  'ANALYZE TABLE tpch.lineitem UPDATE HISTOGRAM ON l_partkey, l_suppkey, l_quantity, '
                  'l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, '
                  'l_receiptdate, l_shipinstruct, l_shipmode WITH 100 BUCKETS;\n'
                  'ANALYZE TABLE tpch.nation UPDATE HISTOGRAM ON n_name, n_regionkey WITH 100 BUCKETS;\n'
                  'ANALYZE TABLE tpch.orders UPDATE HISTOGRAM ON o_custkey, o_orderstatus, o_totalprice, '
                  'o_orderdate, o_orderpriority, o_clerk, o_shippriority WITH 100 BUCKETS;\n'
                  'ANALYZE TABLE tpch.part UPDATE HISTOGRAM ON p_name, p_mfgr, p_brand, p_type, p_size, '
                  'p_container, p_retailprice WITH 100 BUCKETS;\n'
                  'ANALYZE TABLE tpch.partsupp UPDATE HISTOGRAM ON ps_availqty, ps_supplycost WITH 100 BUCKETS;\n'
                  'ANALYZE TABLE tpch.region UPDATE HISTOGRAM ON r_name WITH 100 BUCKETS;\n'
                  'ANALYZE TABLE tpch.supplier UPDATE HISTOGRAM ON s_name, s_address, s_nationkey, s_phone, '
                  's_acctbal WITH 100 BUCKETS;',
        },
        'description': 'column histograms (ANALYZE TABLE ... UPDATE HISTOGRAM, 100 buckets) on all columns '
                       'except primary keys and comments, in initstatistics (-xis): selectivity of filters on '
                       'columns without an index; off: plain ANALYZE TABLE (index statistics only)',
    },
}
