# Benchmark-Experiment-Host-Manager | experiments/tpch/MariaDB
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps).
{
    'engine': {
        'default': 'InnoDB',
        'values': ['InnoDB', 'Aria', 'MyISAM'],
        'description': 'storage engine of all tables (for ColumnStore use -dbms MariaDBCS)',
    },
    'histograms': {
        'default': 'off',
        'values': ['off', 'on'],
        'sql': {'off': '', 'on': 'PERSISTENT FOR ALL'},
        'description': 'engine-independent statistics with histograms (ANALYZE TABLE ... PERSISTENT FOR ALL, '
                       'JSON_HB, a full scan per table) in initstatistics (-xis); off: plain ANALYZE TABLE, '
                       'which collects none (use_stat_tables = PREFERABLY_FOR_QUERIES, MariaDB 12.3)',
    },
    'row_format': {
        'default': 'default',
        'values': ['default', 'DYNAMIC', 'COMPRESSED'],
        'sql': {'default': '', 'DYNAMIC': ' ROW_FORMAT=DYNAMIC', 'COMPRESSED': ' ROW_FORMAT=COMPRESSED'},
        'requires': {'engine': ['InnoDB']},
        'description': 'InnoDB row format of all tables (default: innodb_default_row_format, DYNAMIC): '
                       'COMPRESSED stores pages zlib-compressed: less I/O, more CPU',
    },
}
