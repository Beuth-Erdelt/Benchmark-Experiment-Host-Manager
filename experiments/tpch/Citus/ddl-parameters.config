# Benchmark-Experiment-Host-Manager | experiments/tpch/Citus
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps), num_worker_shards also by -nws.
{
    'num_worker_shards': {
        'default': 32,
        'type': 'int',
        'description': 'citus.shard_count of orders and lineitem (Citus default 32)',
    },
    'columnar_compression': {
        'default': 'default',
        'values': ['default', 'none', 'lz4', 'zstd', 'pglz'],
        'sql': {
            'default': '',
            'none': "ALTER TABLE orders SET (columnar.compression = none);\n"
                    "ALTER TABLE lineitem SET (columnar.compression = none);",
            'lz4': "ALTER TABLE orders SET (columnar.compression = lz4);\n"
                   "ALTER TABLE lineitem SET (columnar.compression = lz4);",
            'zstd': "ALTER TABLE orders SET (columnar.compression = zstd);\n"
                    "ALTER TABLE lineitem SET (columnar.compression = zstd);",
            'pglz': "ALTER TABLE orders SET (columnar.compression = pglz);\n"
                    "ALTER TABLE lineitem SET (columnar.compression = pglz);",
        },
        'description': 'compression of the columnar orders and lineitem (-xcol only; default: '
                       'columnar.compression of the server, zstd): bytes read vs. CPU per scan',
    },
}
