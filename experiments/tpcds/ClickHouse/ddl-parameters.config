# Benchmark-Experiment-Host-Manager | experiments/tpcds/ClickHouse
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps).
{
    'index_granularity': {
        'default': 8192,
        'type': 'int',
        'description': 'rows per granule (= entry of the sparse primary index) of the fact tables (sales, returns, inventory) '
                       '(ClickHouse default 8192): smaller granules skip more precisely, the index grows',
    },
    'wide_parts': {
        'default': 'default',
        'values': ['default', 'wide', 'compact'],
        'sql': {'default': '10485760', 'wide': '0', 'compact': '1099511627776'},
        'description': 'part format of the fact tables (sales, returns, inventory) by min_bytes_for_wide_part: default (10 MiB: '
                       'small parts compact, one file; larger parts wide, a file per column), wide (every '
                       'part), compact (every part up to 1 TiB); parallel loaders write many small parts',
    },
    'low_cardinality': {
        'default': 'off',
        'values': ['off', 'on'],
        'sql': {'off': 'Nullable(String)', 'on': 'LowCardinality(Nullable(String))'},
        'description': 'dictionary encoding of the string columns with few distinct values (states, countries, demographics, date and time names and flags, ship modes, item brands, classes, categories, sizes, colors, units, containers, promotion channels): '
                       'faster filters and GROUP BY',
    },
    'codec': {
        'default': 'default',
        'values': ['default', 'zstd1', 'zstd3'],
        'sql': {'default': '', 'zstd1': ' CODEC(ZSTD(1))', 'zstd3': ' CODEC(ZSTD(3))'},
        'description': 'compression of all columns of the fact tables (sales, returns, inventory) (default: the server setting, '
                       'LZ4): bytes read vs. CPU per scan',
    },
}
