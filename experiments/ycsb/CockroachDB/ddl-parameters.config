# Benchmark-Experiment-Host-Manager | experiments/ycsb/CockroachDB
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps), num_worker_replicas also by -nwr.
{
    'num_worker_replicas': {
        'default': 3,
        'type': 'int',
        'description': 'zone num_replicas of usertable (CockroachDB default 3)',
    },
    'pk_hash': {
        'default': 'hash',
        'values': ['hash', 'none'],
        'sql': {'hash': 'USING HASH', 'none': ''},
        'description': 'hash-sharded primary key: spreads sequential inserts (-xio ordered) over ranges, '
                       'costs range scans (workload e)',
    },
    'bucket_count': {
        'default': 'default',
        'values': ['default', '4', '8', '16', '32', '64'],
        'sql': {
            'default': '',
            '4': ' WITH (bucket_count = 4)',
            '8': ' WITH (bucket_count = 8)',
            '16': ' WITH (bucket_count = 16)',
            '32': ' WITH (bucket_count = 32)',
            '64': ' WITH (bucket_count = 64)',
        },
        'requires': {'pk_hash': ['hash']},
        'description': 'buckets of the hash-sharded primary key (default: cluster setting '
                       'sql.defaults.default_hash_sharded_index_bucket_count, 16 in v24.2): write spread '
                       'vs. scan fan-out',
    },
    'range_max_bytes': {
        'default': 'default',
        'values': ['default', '64MiB', '128MiB', '256MiB'],
        'sql': {
            'default': '',
            '64MiB': ', range_min_bytes = 16777216, range_max_bytes = 67108864',
            '128MiB': ', range_min_bytes = 33554432, range_max_bytes = 134217728',
            '256MiB': ', range_min_bytes = 67108864, range_max_bytes = 268435456',
        },
        'description': 'zone range_max_bytes of usertable (default 512 MiB, range_min_bytes 128 MiB; a '
                       'smaller value sets range_min_bytes to a quarter): more, smaller ranges spread '
                       'leaseholders at small data sizes',
    },
    'column_families': {
        'default': 'one',
        'values': ['one', 'per_field'],
        'sql': {
            'one': '',
            'per_field': ',\n    FAMILY f0 (YCSB_KEY, FIELD0), FAMILY f1 (FIELD1), FAMILY f2 (FIELD2),'
                         '\n    FAMILY f3 (FIELD3), FAMILY f4 (FIELD4), FAMILY f5 (FIELD5),'
                         '\n    FAMILY f6 (FIELD6), FAMILY f7 (FIELD7), FAMILY f8 (FIELD8),'
                         '\n    FAMILY f9 (FIELD9)',
        },
        'description': 'column families of usertable: one family per row, or one per field, so updating '
                       'one field writes one KV pair instead of the whole row (workloads a, b, f); costs '
                       'reads of whole rows',
    },
}
