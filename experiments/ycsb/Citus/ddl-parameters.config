# Benchmark-Experiment-Host-Manager | experiments/ycsb/Citus
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps), num_worker_* also by -nws/-nwr.
{
    'num_worker_shards': {
        'default': 32,
        'type': 'int',
        'description': 'citus.shard_count of usertable (Citus default 32)',
    },
    'num_worker_replicas': {
        'default': 1,
        'type': 'int',
        'description': 'citus.shard_replication_factor of usertable (Citus default 1)',
    },
    'fillfactor': {
        'default': 100,
        'type': 'int',
        'description': 'fillfactor of usertable and its shards (PostgreSQL default 100, allowed 10-100): '
                       'free space per page lets updates stay on the page (HOT updates)',
    },
}
