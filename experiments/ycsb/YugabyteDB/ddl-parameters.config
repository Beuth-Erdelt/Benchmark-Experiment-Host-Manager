{
    'pk_sharding': {
        'default': 'hash',
        'values': ['hash', 'asc'],
        'sql': {'hash': 'HASH', 'asc': 'ASC'},
        'description': 'sharding of the primary key: hash spreads load evenly and suits point reads, '
                       'asc keeps key order for range scans (workload e) but concentrates ordered inserts',
    },
    'num_tablets': {
        'default': 'auto',
        'values': ['auto', '4', '8', '16', '32', '64', '128'],
        'sql': {
            'auto': '',
            '4': 'SPLIT INTO 4 TABLETS',
            '8': 'SPLIT INTO 8 TABLETS',
            '16': 'SPLIT INTO 16 TABLETS',
            '32': 'SPLIT INTO 32 TABLETS',
            '64': 'SPLIT INTO 64 TABLETS',
            '128': 'SPLIT INTO 128 TABLETS',
        },
        'requires': {'pk_sharding': ['hash']},
        'description': 'tablets of usertable from the start (auto: ysql_num_shards_per_tserver and '
                       'automatic splitting); only with pk_sharding=hash (asc needs SPLIT AT VALUES)',
    },
