# Benchmark-Experiment-Host-Manager | experiments/ycsb/TiDB
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps), num_worker_replicas also by -nwr.
{
    'num_worker_replicas': {
        'default': 3,
        'type': 'int',
        'description': 'PD max-replicas (TiDB default 3)',
    },
    'clustered': {
        'default': 'default',
        'values': ['default', 'clustered', 'nonclustered'],
        'sql': {'default': '', 'clustered': 'CLUSTERED', 'nonclustered': 'NONCLUSTERED'},
        'description': 'clustered index of usertable (default: tidb_enable_clustered_index of the server); '
                       'clustered saves a lookup, nonclustered stores rows by a hidden _tidb_rowid',
    },
    'split_regions': {
        'default': 'none',
        'values': ['none', '4', '8', '16', '32', '64', '128'],
        'sql': {
            'none': '',
            '4': "SPLIT TABLE ycsb.usertable BETWEEN ('user0') AND ('user9') REGIONS 4;",
            '8': "SPLIT TABLE ycsb.usertable BETWEEN ('user0') AND ('user9') REGIONS 8;",
            '16': "SPLIT TABLE ycsb.usertable BETWEEN ('user0') AND ('user9') REGIONS 16;",
            '32': "SPLIT TABLE ycsb.usertable BETWEEN ('user0') AND ('user9') REGIONS 32;",
            '64': "SPLIT TABLE ycsb.usertable BETWEEN ('user0') AND ('user9') REGIONS 64;",
            '128': "SPLIT TABLE ycsb.usertable BETWEEN ('user0') AND ('user9') REGIONS 128;",
        },
        'requires': {'clustered': ['default', 'clustered']},
        'description': 'regions of usertable on all TiKV nodes before the load, over the YCSB key range '
                       'user0..user9; needs a clustered key (nonclustered rows are stored by the integer '
                       '_tidb_rowid, which SHARD_ROW_ID_BITS spreads instead). PRE_SPLIT_REGIONS needs '
                       'SHARD_ROW_ID_BITS or AUTO_RANDOM, not a VARCHAR key',
    },
    'shard_row_id_bits': {
        'default': 'none',
        'values': ['none', '2', '4', '6'],
        'sql': {
            'none': '',
            '2': 'SHARD_ROW_ID_BITS = 2',
            '4': 'SHARD_ROW_ID_BITS = 4',
            '6': 'SHARD_ROW_ID_BITS = 6',
        },
        'requires': {'clustered': ['nonclustered']},
        'description': 'shard bits of the hidden _tidb_rowid of a nonclustered usertable (2^n ranges): '
                       'spreads the insert hot spot of increasing row ids; too many cost RPCs in scans',
    },
    'pre_split_regions': {
        'default': 'none',
        'values': ['none', '1', '2', '3', '4'],
        'sql': {
            'none': '',
            '1': 'PRE_SPLIT_REGIONS = 1',
            '2': 'PRE_SPLIT_REGIONS = 2',
            '3': 'PRE_SPLIT_REGIONS = 3',
            '4': 'PRE_SPLIT_REGIONS = 4',
        },
        'requires': {'shard_row_id_bits': ['4', '6']},
        'description': '2^n regions of the sharded row ids when the table is created, instead of splitting '
                       'during the load; needs shard_row_id_bits at least n',
    },
}
