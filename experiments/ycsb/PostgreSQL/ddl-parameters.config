# Benchmark-Experiment-Host-Manager | experiments/ycsb/PostgreSQL
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps).
{
    'fillfactor': {
        'default': 100,
        'type': 'int',
        'description': 'fillfactor of usertable (PostgreSQL default 100, allowed 10-100): free space per page '
                       'lets updates stay on the page (HOT updates, see n_tup_hot_upd in pg_stat_user_tables)',
    },
    'autovacuum_scale': {
        'default': '0.2',
        'values': ['0.2', '0.1', '0.05', '0.01'],
        'description': 'autovacuum_vacuum_scale_factor of usertable (PostgreSQL default 0.2): share of dead '
                       'rows that starts an autovacuum; lower values vacuum earlier in update-heavy runs '
                       '(see autovacuum_count in pg_stat_user_tables)',
    },
}
