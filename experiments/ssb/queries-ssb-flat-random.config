		{
			'title': 'Q2.1: Revenue by year and brand for a product category and supplier region (SSB Q2.1)',
			'query': """select sum(lo_revenue) as revenue, cast(extract(year from lo_orderdate) as integer) as d_year, p_brand1
from lineorder_flat
where p_category = 'MFGR#{CATEGORY}'
and s_region = '{REGION}'
group by cast(extract(year from lo_orderdate) as integer), p_brand1
order by d_year, p_brand1""",
			'DBMS': {
				'MySQL': """select sum(lo_revenue) as revenue, extract(year from lo_orderdate) as d_year, p_brand1
from lineorder_flat
where p_category = 'MFGR#{CATEGORY}'
and s_region = '{REGION}'
group by extract(year from lo_orderdate), p_brand1
order by d_year, p_brand1""",
			},
