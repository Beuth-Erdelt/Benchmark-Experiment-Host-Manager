		{
			'title': 'Q1.1: Revenue increase from eliminating discounts in a year (SSB Q1.1)',
			'query': """select sum(lo_extendedprice*lo_discount) as revenue
from lineorder_flat
where lo_orderdate >= date '{YEAR1}-01-01' and lo_orderdate < date '{YEAR2}-01-01'
and lo_discount between {DISCOUNT} - 1 and {DISCOUNT} + 1
and lo_quantity < {QUANTITY}""",
			'parameter': {
				'YEAR': {'type': 'dict', 'range': {'1993': ['1994'], '1994': ['1995'], '1995': ['1996'], '1996': ['1997'], '1997': ['1998']}},
				'DISCOUNT': {'type': 'integer', 'range': [2, 9]},
