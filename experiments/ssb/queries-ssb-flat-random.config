		{
			'title': 'Q4.1: Profit by year and customer nation for a region and two manufacturers (SSB Q4.1)',
			'query': """select cast(extract(year from lo_orderdate) as integer) as d_year, c_nation, sum(lo_revenue - lo_supplycost) as profit
from lineorder_flat
where c_region = '{REGION}'
and s_region = '{REGION}'
and (p_mfgr = 'MFGR#{MFGR1}' or p_mfgr = 'MFGR#{MFGR2}')
group by cast(extract(year from lo_orderdate) as integer), c_nation
order by d_year, c_nation""",
