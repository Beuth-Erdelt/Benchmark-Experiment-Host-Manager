	'queries':
	[
		{
			'title': 'Q1.1: Revenue increase from eliminating discounts in a year (SSB Q1.1)',
			'query': """select sum(lo_extendedprice*lo_discount) as revenue
from lineorder_flat
where lo_orderdate >= date '1993-01-01' and lo_orderdate < date '1994-01-01'
and lo_discount between 1 and 3
and lo_quantity < 25""",
			'active': True,
			'numWarmup': 0,
			'numCooldown': 0,
			'numRun': 1,
			'timer':
			{
				'datatransfer':
