		{
			'title': 'Q3.1: Revenue by customer and supplier nation and year within a region (SSB Q3.1)',
			'query': """select c_nation, s_nation, cast(extract(year from lo_orderdate) as integer) as d_year, sum(lo_revenue) as revenue
from lineorder_flat
where c_region = 'ASIA'
and s_region = 'ASIA'
and lo_orderdate >= date '1992-01-01' and lo_orderdate < date '1998-01-01'
group by c_nation, s_nation, cast(extract(year from lo_orderdate) as integer)
order by d_year asc, revenue desc""",
			'DBMS': {
