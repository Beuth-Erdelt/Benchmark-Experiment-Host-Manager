# Benchmark-Experiment-Host-Manager | experiments/ssb/ClickHouse
# DDL parameters of the scripts in this folder (see bexhoma/ddl_parameters.py).
# Set by -xddl KEY=VALUE (a comma list sweeps).
{
    'order_lineorder': {
        'default': 'date',
        'values': ['date', 'key'],
        'sql': {'date': '(lo_orderdate, lo_orderkey)', 'key': '(lo_orderkey, lo_linenumber)'},
        'description': 'sort key (= primary index) of the fact table: by order date first, so the date '
                       'filters of all flights skip granules, or by key',
    },
    'index_granularity': {
        'default': 8192,
        'type': 'int',
        'description': 'rows per granule (= entry of the sparse primary index) of the fact table lineorder (lineorder_flat with -xsv flat) '
                       '(ClickHouse default 8192): smaller granules skip more precisely, the index grows',
    },
    'wide_parts': {
        'default': 'default',
        'values': ['default', 'wide', 'compact'],
        'sql': {'default': '10485760', 'wide': '0', 'compact': '1099511627776'},
        'description': 'part format of the fact table lineorder (lineorder_flat with -xsv flat) by min_bytes_for_wide_part: default (10 MiB: '
                       'small parts compact, one file; larger parts wide, a file per column), wide (every '
                       'part), compact (every part up to 1 TiB); parallel loaders write many small parts',
    },
    'low_cardinality': {
        'default': 'off',
        'values': ['off', 'on'],
        'sql': {'off': 'String', 'on': 'LowCardinality(String)'},
        'description': 'dictionary encoding of the string columns with few distinct values (cities, nations, regions, segments, part categories, brands, colors, types, containers, date names and flags, priorities, ship modes): '
                       'faster filters and GROUP BY',
    },
    'codec': {
        'default': 'default',
        'values': ['default', 'zstd1', 'zstd3'],
        'sql': {'default': '', 'zstd1': ' CODEC(ZSTD(1))', 'zstd3': ' CODEC(ZSTD(3))'},
        'description': 'compression of all columns of the fact table lineorder (lineorder_flat with -xsv flat) (default: the server setting, '
                       'LZ4): bytes read vs. CPU per scan',
    },
}
